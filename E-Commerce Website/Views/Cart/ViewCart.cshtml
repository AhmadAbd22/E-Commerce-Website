@using ECommerceWebsite.Models.Dtos
@model CartDto
@{
    ViewData["Title"] = "Shopping Cart";
    Layout = "_MinimumLayout";
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4><i class="icon-cart position-left"></i> <span class="text-semibold">Shopping Cart</span></h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("UserHome", "UserHome")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li class="active">Cart</li>
        </ul>
    </div>
</div>
<!-- /page header -->
<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        @TempData["Error"]
    </div>
}

<!-- Content area -->
<div class="content">
    @if (!Model.CartItems.Any())
    {
        <div class="panel panel-flat">
            <div class="panel-body text-center">
                <i class="icon-cart icon-3x text-muted mb-20"></i>
                <h4 class="text-muted">Your cart is empty</h4>
                <p class="text-muted">Add some books to your cart to get started!</p>
                <a href="@Url.Action("UserHome", "UserHome")" class="btn btn-primary">
                    <i class="icon-arrow-left8 position-left"></i> Continue Shopping
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-8">
                <!-- Cart Items -->
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <h5 class="panel-title">Cart Items (@Model.ItemCount items)</h5>
                    </div>
                    <div class="panel-body">
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="media mb-20">
                                <div class="media-left">
                                    <img src="@item.ImageUrl" alt="@item.BookTitle" class="img-rounded" style="width: 80px; height: 100px; object-fit: cover;">
                                </div>
                                <div class="media-body">
                                    <h6 class="media-heading text-semibold">@item.BookTitle</h6>
                                    <p class="text-muted">by @item.AuthorName</p>
                                    <p class="text-success">Rs. @item.BookPrice</p>

                                    <div class="row">
                                        <div class="col-sm-4">
                                            <form method="post" action="@Url.Action("UpdateQuantity", "Cart")" style="display: inline;">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <div class="input-group" style="width: 120px;">
                                                    <input type="number" name="quantity" class="form-control text-center" value="@item.Quantity" min="1" max="@item.StockAvailable">
                                                    <span class="input-group-btn">
                                                        <button type="submit" class="btn btn-default btn-sm">Update</button>
                                                    </span>
                                                </div>
                                            </form>
                                        </div>
                                        <div class="col-sm-4">
                                            <span class="text-semibold">Rs. @item.Subtotal</span>
                                        </div>
                                        <div class="col-sm-4">
                                            <form method="post" action="@Url.Action("RemoveFromCart", "Cart")" style="display: inline;">
                                                <input type="hidden" name="cartItemId" value="@item.Id" />
                                                <button type="submit" class="btn btn-link text-danger p-0" onclick="return confirm('Remove this item from cart?')">
                                                    <i class="icon-trash"></i> Remove
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <hr>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- Order Summary -->
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <h5 class="panel-title">Order Summary</h5>
                    </div>
                    <div class="panel-body">
                        <div class="row mb-10">
                            <div class="col-xs-6">Items (@Model.ItemCount):</div>
                            <div class="col-xs-6 text-right">Rs. @Model.TotalAmount</div>
                        </div>
                        <div class="row mb-10">
                            <div class="col-xs-6">Shipping:</div>
                            <div class="col-xs-6 text-right">Free</div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-xs-6"><strong>Total:</strong></div>
                            <div class="col-xs-6 text-right"><strong>Rs. @Model.TotalAmount</strong></div>
                        </div>

                        <div class="mt-20">
                            <a href="@Url.Action("Checkout", "Cart")" class="btn btn-success btn-block btn-lg">
                                <i class="icon-checkmark position-left"></i> Proceed to Checkout
                            </a>
                            <a href="@Url.Action("UserHome", "UserHome")" class="btn btn-default btn-block mt-10">
                                <i class="icon-arrow-left8 position-left"></i> Continue Shopping
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
<!-- /content area -->
