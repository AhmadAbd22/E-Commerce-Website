@using ECommerceWebsite.Models.Dtos
@model CheckoutDto
@{
    ViewData["Title"] = "Checkout";
    Layout = "_UserLayout";
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4><i class="icon-checkmark position-left"></i> <span class="text-semibold">Checkout</span></h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("UserHome", "UserHome")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li><a href="@Url.Action("ViewCart", "Cart")">Cart</a></li>
            <li class="active">Checkout</li>
        </ul>
    </div>
</div>
<!-- /page header -->
<!-- Success/Error Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        @TempData["Error"]
    </div>
}

<!-- Content area -->
<div class="content">
    <form action="@Url.Action("PlaceOrder", "Cart")" method="post">
        <div class="row">
            <div class="col-md-8">
                <!-- Shipping Information -->
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <h5 class="panel-title">Shipping Information</h5>
                    </div>
                    <div class="panel-body">
                        <div class="form-group">
                            <label for="ShippingAddress" class="text-semibold">Shipping Address *</label>
                            <textarea name="ShippingAddress" class="form-control" rows="3" placeholder="Enter your complete address" required></textarea>
                            <span validation-for="ShippingAddress" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="City" class="text-semibold">City *</label>
                                    <input name="City" class="form-control" placeholder="Enter city" required>
                                    <span validation-for="City" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="form-group">
                                    <label for="PhoneNumber" class="text-semibold">Phone Number *</label>
                                    <input id ="PhoneNumber" class="form-control" type="tel" placeholder="e.g. 123-8765444" required>
                                    <span id="PhoneNumber" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <!-- Order Summary -->
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <h5 class="panel-title">Order Summary</h5>
                    </div>
                    <div class="panel-body">
                        <!-- Cart Items -->
                        @foreach (var item in Model.CartItems)
                        {
                            <div class="media mb-15">
                                <div class="media-left">
                                    <img src="@item.ImageUrl" alt="@item.BookTitle" class="img-rounded" style="width: 50px; height: 60px;">
                                </div>
                                <div class="media-body">
                                    <h6 class="media-heading no-margin">@item.BookTitle</h6>
                                    <span class="text-muted text-size-small">by @item.AuthorName</span>
                                    <div class="mt-5">
                                        <span class="text-semibold">@item.Quantity × Rs. @item.BookPrice.ToString("F2")</span>
                                        <span class="pull-right text-semibold">Rs. @item.Subtotal.ToString("F2")</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <hr>

                        <!-- Order Totals -->
                        <div class="row mb-10">
                            <div class="col-xs-6">Subtotal:</div>
                            <div class="col-xs-6 text-right">Rs. @Model.TotalAmount.ToString("N2")</div>
                        </div>
                        <div class="row mb-10">
                            <div class="col-xs-6">Shipping:</div>
                            <div class="col-xs-6 text-right">Free</div>
                        </div>
                        <hr>
                        <div class="row">
                            <div class="col-xs-6"><strong>Total:</strong></div>
                            <div class="col-xs-6 text-right"><strong>Rs. @Model.TotalAmount.ToString("N2")</strong></div>
                        </div>

                        <!-- Place Order Button -->
                        <div class="mt-20">
                            <button type="submit" class="btn btn-success btn-block btn-lg" id="PlaceOrderBtn">
                                <i class="icon-credit-card position-left"></i> Place Order
                            </button>
                            <a href="@Url.Action("ViewCart", "Cart")" class="btn btn-default btn-block mt-10">
                                <i class="icon-arrow-left8 position-left"></i> Back to Cart
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
<!-- /content area -->
@section Scripts {
    <script>
        $(document).ready(function () {

            function validatePhone(showError = false) {
                var phone = $("#PhoneNumber").val().trim();
                var digits = phone.replace(/\D/g, "");
                let isValid = true;

                if (digits.length !== 11 || !digits.startsWith("03")) {
                    if (showError || digits.length > 0) {
                        $("#PhoneNumberError").text("Enter a valid mobile number (e.g. 0333-8564345).");
                    }
                    isValid = false;
                } else {
                    $("#PhoneNumberError").text("");
                }

                return isValid;
            }

            function validateForm(showError = false) {
                var shippingAddress = $("textarea[name='ShippingAddress']").val().trim();
                var city = $("input[name='City']").val().trim();
                let isValid = true;

                if (!validatePhone(showError)) isValid = false;
                if (shippingAddress === "" || city === "") isValid = false;

                $("#PlaceOrderBtn").prop("disabled", !isValid);
            }

            $("#PhoneNumber").on("input", function () {
                var digits = $(this).val().replace(/\D/g, "");

                if (digits.length > 11) {
                    digits = digits.substring(0, 11);
                }

                // Format as 0333-1234567
                if (digits.length > 4) {
                    $(this).val(digits.replace(/(\d{4})(\d{0,7})/, "$1-$2"));
                } else {
                    $(this).val(digits);
                }

                // validate while typing, but only show error if invalid start
                validateForm(false);
                validatePhone(false);
            });

            // Show error clearly when leaving the field
            $("#PhoneNumber").on("blur", function () {
                validateForm(true);
            });

            $("textarea[name='ShippingAddress'], input[name='City']").on("input", function () {
                validateForm(false);
            });

            // Initial state
            validateForm(false);
        });
    </script>
}
