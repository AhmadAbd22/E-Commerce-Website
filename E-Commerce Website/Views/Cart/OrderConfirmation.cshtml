@using ECommerceWebsite.Models.Dtos
@model OrderConfirmationDto
@{
    ViewData["Title"] = "Order Confirmation";
    Layout = "_UserLayout";


    string processingClass = "";
    string shippedClass = "";
    string deliveredClass = "";
    bool isCancelled = false;

    switch (Model.OrderStatus?.ToLower())
    {
        case "pending":
        case "confirmed":
            processingClass = "active";
            break;
        case "shipped":
            processingClass = "completed";
            shippedClass = "active";
            break;
        case "delivered":
            processingClass = "completed";
            shippedClass = "completed";
            deliveredClass = "completed"; 
            break;
        case "cancelled":
            isCancelled = true;
            break;
    }
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4><i class="icon-checkmark2 position-left text-success"></i> <span class="text-semibold">Order Confirmed!</span></h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("UserHome", "UserHome")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li><a href="@Url.Action("ViewCart", "Cart")">Cart</a></li>
            <li class="active">Order Confirmation</li>
        </ul>
    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">

    <!-- Success Message -->
    <div class="alert alert-success alert-styled-left alert-bordered">
        <i class="icon-checkmark3"></i>
        <strong>Thank you for your order!</strong> Your order has been placed successfully and is being processed.
    </div>

    <div class="row">
        <div class="col-md-8">
            <!-- Order Details -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Order Details</h5>
                </div>
                <div class="panel-body">
                    <div class="row">
                        <div class="col-sm-6">
                            <h6 class="text-semibold">Order Information</h6>
                            <ul class="list-unstyled">
                                <li><strong>Order ID:</strong> @Model.OrderId</li>
                                <li><strong>Order Date:</strong> @Model.OrderDate.ToString("dd mm, yyyy 'at' hh:mm tt")</li>
                                <li><strong>Status:</strong> <span class="label label-success">@Model.OrderStatus</span></li>
                                <li><strong>Estimated Delivery:</strong> @Model.EstimatedDeliveryDate.ToString("MMMM dd, yyyy")</li>
                            </ul>
                        </div>
                        <div class="col-sm-6">
                            <h6 class="text-semibold">Shipping Address</h6>
                            <address>
                                @Model.ShippingAddress<br>
                                @Model.City<br>
                                <strong>Phone:</strong> @Model.PhoneNumber
                            </address>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Order Items -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Order Items (@Model.OrderItems.Count items)</h5>
                </div>
                <div class="panel-body">
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="media mb-20">
                            <div class="media-left">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.BookTitle" class="img-rounded" style="width: 80px; height: 100px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="bg-light" style="width: 80px; height: 100px; display: flex; align-items: center; justify-content: center; border-radius: 4px;">
                                        <i class="icon-book text-muted" style="font-size: 24px;"></i>
                                    </div>
                                }
                            </div>
                            <div class="media-body">
                                <h6 class="media-heading text-semibold">@item.BookTitle</h6>
                                <p class="text-muted">by @item.AuthorName</p>
                                <div class="row">
                                    <div class="col-sm-3">
                                        <small class="text-muted">Quantity:</small><br>
                                        <span class="text-semibold">@item.Quantity</span>
                                    </div>
                                    <div class="col-sm-3">
                                        <small class="text-muted">Unit Price:</small><br>
                                        <span class="text-semibold">Rs. @item.UnitPrice.ToString("F2")</span>
                                    </div>
                                    <div class="col-sm-3">
                                        <small class="text-muted">Subtotal:</small><br>
                                        <span class="text-semibold text-success">Rs. @item.Subtotal.ToString("F2")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Order Summary -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">Order Summary</h5>
                </div>
                <div class="panel-body">
                    <div class="row mb-10">
                        <div class="col-xs-6">Items Total:</div>
                        <div class="col-xs-6 text-right">Rs. @Model.TotalAmount.ToString("F2")</div>
                    </div>
                    <div class="row mb-10">
                        <div class="col-xs-6">Shipping:</div>
                        <div class="col-xs-6 text-right text-success">Free</div>
                    </div>
                    <div class="row mb-10">
                        <div class="col-xs-6">Tax:</div>
                        <div class="col-xs-6 text-right">Rs. 0.00</div>
                    </div>
                    <hr>
                    <div class="row">
                        <div class="col-xs-6"><strong>Total:</strong></div>
                        <div class="col-xs-6 text-right"><strong class="text-success">Rs. @Model.TotalAmount.ToString("F2")</strong></div>
                    </div>
                </div>
            </div>

            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title">What's Next?</h5>
                </div>
                <div class="panel-body">
                    <div class="step-basic">

                        @if (isCancelled)
                        {
                            <!-- Special tracker for Cancelled orders -->
                            <ul class="list-unstyled">
                                <li class="completed">
                                    <span class="step"><i class="icon-check"></i></span>
                                    <span class="step-content">Order Placed</span>
                                </li>
                                <li class="step-cancelled">
                                    <span class="step"><i class="icon-cross2"></i></span>
                                    <span class="step-content">Order Cancelled</span>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <!-- Standard tracker for active/completed orders -->
                            <ul class="list-unstyled">
                                <li class="completed">
                                    <span class="step">1</span>
                                    <span class="step-content">Order Placed</span>
                                </li>
                                <li class="@processingClass">
                                    <span class="step">2</span>
                                    <span class="step-content">Processing</span>
                                </li>
                                <li class="@shippedClass">
                                    <span class="step">3</span>
                                    <span class="step-content">Shipped</span>
                                </li>
                                <li class="@deliveredClass">
                                    <span class="step">4</span>
                                    <span class="step-content">Delivered</span>
                                </li>
                            </ul>
                        }
                    </div>

                    <div class="mt-20">
                        <p class="text-muted">We'll send you email updates about your order status.</p>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="panel panel-flat">
                <div class="panel-body">
                    <a href="@Url.Action("UserHome", "UserHome")" class="btn btn-success btn-block">
                        <i class="icon-cart-add position-left"></i> Continue Shopping
                    </a>
                    <button type="button" class="btn btn-default btn-block mt-10" onclick="window.print()">
                        <i class="icon-printer position-left"></i> Print Order
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /content area -->
@section Styles {
    <style>
        .step-basic .step {
            background: #eee;
            border-radius: 50%;
            color: #999;
            display: inline-block;
            font-size: 12px;
            font-weight: bold;
            height: 30px;
            line-height: 30px;
            margin-right: 10px;
            text-align: center;
            width: 30px;
        }

        .step-basic .completed .step {
            background: #4CAF50;
            color: white;
        }

        .step-basic .active .step {
            background: #2196F3;
            color: white;
        }

        .step-basic .step-cancelled .step {
            background: #F44336;
            color: white;
        }
        /* Style for the cancelled step */
        .step-basic li {
            margin-bottom: 15px;
            position: relative;
        }

            .step-basic li:not(:last-child):before {
                background: #eee;
                content: '';
                height: 20px;
                left: 14px;
                position: absolute;
                top: 35px;
                width: 2px;
            }

        .step-basic .completed:not(:last-child):before {
            background: #4CAF50;
        }
    </style>
}

