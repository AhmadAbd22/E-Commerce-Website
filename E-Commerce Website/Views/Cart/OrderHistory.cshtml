@using ECommerceWebsite.Models.Dtos
@model OrderHistoryDto
@{
    ViewData["Title"] = "Order History";
    Layout = "_UserLayout";
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4><i class="icon-history position-left"></i> <span class="text-semibold">Order History</span></h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("UserHome", "UserHome")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li class="active">Order History</li>
        </ul>
    </div>
</div>
<!-- /page header -->
<!-- Success/Error Messages -->
<!-- Content area -->
<div class="content">
    <!-- Order Statistics -->
    <div class="row">
        <div class="col-sm-6 col-md-3">
            <div class="panel panel-body bg-blue-400 has-bg-image">
                <div class="media no-margin">
                    <div class="media-body">
                        <h3 class="no-margin">@Model.TotalOrders</h3>
                        <span class="text-uppercase text-size-mini">Total Orders</span>
                    </div>
                    <div class="media-right media-middle">
                        <i class="icon-bag icon-3x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-3">
            <div class="panel panel-body bg-success-400 has-bg-image">
                <div class="media no-margin">
                    <div class="media-body">
                        <h3 class="no-margin">Rs. @Model.TotalSpent.ToString("F2")</h3>
                        <span class="text-uppercase text-size-mini">Total Spent</span>
                    </div>
                    <div class="media-right media-middle">
                        <i class="icon-cash3 icon-3x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-3">
            <div class="panel panel-body bg-warning-400 has-bg-image">
                <div class="media no-margin">
                    <div class="media-body">
                        <h3 class="no-margin">@Model.Orders.Count(o => o.OrderStatus.ToLower() == "pending")</h3>
                        <span class="text-uppercase text-size-mini">Pending Orders</span>
                    </div>
                    <div class="media-right media-middle">
                        <i class="icon-hour-glass2 icon-3x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-md-3">
            <div class="panel panel-body bg-info-400 has-bg-image">
                <div class="media no-margin">
                    <div class="media-body">
                        <h3 class="no-margin">@Model.Orders.Count(o => o.OrderStatus.ToLower() == "delivered")</h3>
                        <span class="text-uppercase text-size-mini">Delivered Orders</span>
                    </div>
                    <div class="media-right media-middle">
                        <i class="icon-check icon-3x opacity-75"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Orders List -->
    @foreach (var order in Model.Orders)
    {
        <div class="panel panel-flat">
            <div class="panel-heading">
                <div class="row">
                    <div class="col-md-8">
                        <h6 class="panel-title">
                            <i class="icon-bag position-left"></i>
                            Order #@order.OrderId.ToString().Substring(0, 8).ToUpper()
                            <span class="label label-@order.StatusColor">
                                <i class="@order.StatusIcon position-left"></i>
                                @order.OrderStatus
                            </span>
                        </h6>
                    </div>
                    <div class="col-md-4 text-right">
                        <span class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>
            </div>

            <div class="panel-body">
                <!-- Order Info Row -->
                <div class="row mb-15">
                    <div class="col-md-3">
                        <strong>Total Amount:</strong><br>
                        <span class="text-success text-size-large">Rs. @order.TotalAmount.ToString("F2")</span>
                    </div>
                    <div class="col-md-3">
                        <strong>Items:</strong><br>
                        @order.TotalItems item@(order.TotalItems != 1 ? "s" : "")
                    </div>
                    <div class="col-md-3">
                        <strong>Shipping To:</strong><br>
                        @order.City
                    </div>
                    <div class="col-md-3">
                        @if (order.EstimatedDeliveryDate.HasValue)
                        {
                            <strong>Estimated Delivery:</strong>
                            <br>
                            @order.EstimatedDeliveryDate.Value.ToString("MMM dd, yyyy")
                        }
                    </div>
                </div>

                <!-- Order Items -->
                <div class="table-responsive">
                    <table class="table table-borderless">
                        <thead>
                            <tr class="bg-light">
                                <th>Book</th>
                                <th width="100">Quantity</th>
                                <th width="120">Unit Price</th>
                                <th width="120">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in order.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="media">
                                            <div class="media-left">
                                                <!-- Added a fallback image -->
                                                <img src="@(item.ImageUrl ?? "/images/default_book.png")" alt="@item.BookTitle" class="img-rounded" style="width: 50px; height: 60px;">
                                            </div>
                                            <div class="media-body">
                                                <h6 class="media-heading">
                                                    <!-- Link to book details page -->
                                                    <a href="@Url.Action("Details", "UserHome", new { id = item.BookId })">@item.BookTitle</a>
                                                </h6>
                                                <span class="text-muted text-size-small">by @item.AuthorName</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge badge-flat bg-blue">@item.Quantity</span>
                                    </td>
                                    <td>Rs. @item.UnitPrice.ToString("F2")</td>
                                    <td><strong>Rs. @item.Subtotal.ToString("F2")</strong></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Order Actions -->
                <div class="text-right mt-10">
                    <a href="@Url.Action("OrderConfirmation", "Cart", new { orderId = order.OrderId })" class="btn btn-default">
                        <i class="icon-eye position-left"></i> View Details
                    </a>

        
                    <!-- Conditionally show Cancel Order button. Button won't show if the order has been shipped -->
                    @if (order.OrderStatus.ToLower() == "pending" || order.OrderStatus.ToLower() == "confirmed")
                    {
                        <!-- Use a form for the POST action -->
                        <form action="@Url.Action("CancelOrder","Cart")" method="post" onsubmit="return confirm('Are you sure you want to cancel this order? This action cannot be undone.');" style="display: inline-block; margin-left: 5px;">
                            <input type="hidden" name="orderId" value="@order.OrderId" />
                            <button type="submit" class="btn btn-danger">
                                <i class="icon-cross2 position-left"></i> Cancel Order
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }

    @if (!Model.Orders.Any())
    {
        <div class="panel panel-body text-center">
            <i class="icon-cart-remove icon-3x text-muted"></i>
            <h5 class="text-semibold mt-15">You haven't placed any orders yet.</h5>
            <p class="text-muted mb-15">Browse our collection and find your next favorite book!</p>
        </div>
    }

    <!-- Back to Shopping Button -->
    <div class="text-center mt-20">
        <a href="@Url.Action("UserHome", "UserHome")" class="btn btn-primary btn-lg">
            <i class="icon-arrow-left13 position-left"></i> Continue Shopping
        </a>
    </div>
</div>

</div>
<!-- /content area -->
@section Scripts {
    <script>
        // Auto-hide alerts after 5 seconds
        $(document).ready(function() {
            // Check if an alert exists
            if($('.alert').length > 0) {
                setTimeout(function() {
                    $('.alert').fadeOut('slow');
                }, 5000); // 5000 milliseconds = 5 seconds
            }
        });
    </script>
}

@section Styles {
    <style>
        .has-bg-image {
            background-size: cover;
        }

        .media img {
            object-fit: cover;
        }

        .badge-flat {
            border-radius: 0;
            font-weight: 500;
        }

        .panel-heading .row {
            margin: 0;
            align-items: center;
        }

        .label {
            font-size: 11px;
            padding: 4px 8px;
            vertical-align: middle;
        }
    </style>
}