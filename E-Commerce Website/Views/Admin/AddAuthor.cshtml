@using ECommerceWebsite.Models
@model ECommerceWebsite.Models.Dtos.AuthorDto
@{
    Layout = "_MinimumLayout";
    ViewData["Title"] = "Manage Authors";
    var authors = ViewData["Authors"] as IEnumerable<Author> ?? new List<Author>();
}

@if (ViewData["AuthorExists"] != null)
{
    <div class="alert alert-danger">@ViewData["AuthorExists"]</div>
}
@if (ViewData["EmptyFields"] != null)
{
    <div class="alert alert-warning">@ViewData["EmptyFields"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4><i class="icon-user-plus position-left"></i> <span class="text-semibold">Admin</span> - Manage Authors</h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Admin", "Admin")"><i class="icon-home2 position-left"></i> Admin</a></li>
            <li class="active">Authors</li>
        </ul>
    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">
    <div class="row">

        <!-- Left column: Add/Edit Author Form -->
        <div class="col-md-4">
            <form action="@(ViewData["IsEditing"] != null ? Url.Action("EditAuthor", "Admin") : Url.Action("AddAuthor", "Admin"))" method="post">
                @if (ViewData["IsEditing"] != null)
                {
                    <input type="hidden" name="AuthorId" value="@Model?.AuthorId" />
                }

                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <h5 class="panel-title text-semibold">
                            @(ViewData["IsEditing"] != null ? "Edit Author" : "Add New Author")
                        </h5>
                    </div>
                    <div class="panel-body">
                        <div class="form-group has-feedback">
                            <label class="text-semibold">Author's Full Name:</label>
                            <input type="text" name="Name" value="@Model?.Name" class="form-control" placeholder="e.g., J.K. Rowling" required>
                            <div class="form-control-feedback">
                                <i class="icon-user"></i>
                            </div>
                        </div>
                        <div class="text-right">
                            <button type="submit" class="btn btn-primary">
                                @(ViewData["IsEditing"] != null ? "Update Author" : "Add Author")
                                <i class="icon-@(ViewData["IsEditing"] != null ? "checkmark" : "plus3") position-right"></i>
                            </button>
                            @if (ViewData["IsEditing"] != null)
                            {
                                <a href="@Url.Action("AddAuthor", "Admin")" class="btn btn-default">Cancel</a>
                            }
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Right column: Author List -->
        <div class="col-md-8">
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h5 class="panel-title text-semibold">Existing Authors</h5>
                </div>

                <div class="panel-body">
                    <div class="form-group has-feedback has-feedback-left">
                        <input type="search" id="author-search" class="form-control" placeholder="Search authors...">
                        <div class="form-control-feedback">
                            <i class="icon-search4 text-size-small text-muted"></i>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="author-table" class="table table-striped table-hover">
                        <thead>
                            <tr class="bg-blue">
                                <th>Author Name</th>
                                <th class="text-center" style="width: 100px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!authors.Any())
                            {
                                <tr>
                                    <td colspan="2" class="text-center text-muted">No authors found. Add one using the form on the left.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var author in authors)
                                {
                                    <tr>
                                        <td>@author.AuthorName</td>
                                        <td class="text-center">
                                            <ul class="icons-list">
                                                <li><a href="@Url.Action("EditAuthor", "Admin", new { id = author.Id })" data-popup="tooltip" title="Edit"><i class="icon-pencil7"></i></a></li>
                                                <li>
                                                    <form method="post" action="@Url.Action("RemoveAuthor", "Admin")" style="display: inline;">
                                                        <input type="hidden" name="authorId" value="@author.Id" />
                                                        <button type="submit" class="btn btn-link p-0 delete-btn" data-popup="tooltip" title="Delete" onclick="return confirm('Are you sure?')">
                                                            <i class="icon-trash"></i>
                                                        </button>
                                                    </form>
                                                </li>
                                            </ul>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /content area -->
@section Scripts {
    <script type="text/javascript">
        $(function() {
            // Initialize tooltips for the action icons
            $('[data-popup="tooltip"]').tooltip();

            $('#author-search').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $("#author-table tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            // Delete confirmation pop-up
            $('.delete-link').on('click', function(e) {
                e.preventDefault();
                var link = $(this).attr('@Url.Action("RemoveAuthor", "Admin")');
                if (confirm("Are you sure you want to delete this author?")) {

                    alert("Delete action confirmed (demo).");
                }
            });
        });
    </script>
}

