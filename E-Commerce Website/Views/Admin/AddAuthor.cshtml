@model ECommerceWebsite.Models.Dtos.AuthorDto
@{
    ViewData["Title"] = "Manage Authors";
    Layout = "_AdminLayout";

    var isEditing = ViewData["IsEditing"] as bool? == true;
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentSortBy = ViewData["CurrentSortBy"] as string ?? "name_asc";
    var existingAuthors = ViewData["ExistingAuthors"] as ECommerceWebsite.Models.Helping_Classes.PagedResult<Author>;
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content"><div class="page-title"><h4><i class="icon-user-plus position-left"></i> <span class="text-semibold">Authors</span> - Management</h4></div></div>
    <div class="breadcrumb-line"><ul class="breadcrumb"><li><a href="@Url.Action("Admin", "Admin")"><i class="icon-home2 position-left"></i> Home</a></li><li class="active">Authors</li></ul></div>
</div>

<div class="content">
    <div class="row">
        <!-- Add/Edit Author Form Panel -->
        <div class="col-md-4">
            <form action="@(isEditing ? Url.Action("EditAuthor", "Admin") : Url.Action("AddAuthor", "Admin"))" method="post">
                <div class="panel panel-flat">
                    <div class="panel-heading"><h6 class="panel-title">@(isEditing ? "Edit Author" : "Add New Author")</h6></div>
                    <div class="panel-body">
                        @if (isEditing)
                        {
                            <input type="hidden" name="AuthorId" value="@Model.AuthorId" />
                        }
                        <div class="form-group">
                            <label>Author Name:</label>
                            <input type="text" name="Name" class="form-control" placeholder="e.g., J.R.R. Tolkien" value="@Model.Name">
                            @if (ViewData["EmptyFields"] != null)
                            {
                                <span class="help-block text-danger">@ViewData["EmptyFields"]</span>
                            }
                            @if (ViewData["AuthorExists"] != null)
                            {
                                <span class="help-block text-danger">@ViewData["AuthorExists"]</span>
                            }
                        </div>
                        <div class="text-right">
                            @if (isEditing)
                            {
                                <a href="@Url.Action("AddAuthor", "Admin")" class="btn btn-default">Cancel</a>
                            }
                            <button type="submit" class="btn btn-primary">Save Author <i class="glyphicon glyphicon-floppy-disk"></i></button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Existing Authors List Panel -->
        <div class="col-md-8">
            <div class="panel panel-flat">
                <div class="panel-heading"><h6 class="panel-title">Existing Authors</h6></div>
                <div class="panel-body">
                    <!-- Filter and Sort Controls -->
                    <div class="row">
                        <div class="col-md-6">
                            <input type="search" id="search-input" class="form-control" placeholder="Search authors..." value="@currentSearch">
                        </div>
                        <div class="col-md-6">
                            <select id="sort-by" class="form-control">
                                <option value="name_asc" selected="@(currentSortBy == "name_asc")">Sort by Name (A-Z)</option>
                                <option value="name_desc" selected="@(currentSortBy == "name_desc")">Sort by Name (Z-A)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- AJAX Container for the list -->
                <div id="author-list-container">
                    @if (existingAuthors != null)
                    {
                        @await Html.PartialAsync("_AuthorListPartial", existingAuthors)
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(function() {
            var debounceTimeout;

            function fetchAuthors(pageNumber) {
                var search = $('#search-input').val();
                var sortBy = $('#sort-by').val();
                var pageSize = $('#author-list-container #page-size-selector').val() || 10;
                var url = `@Url.Action("AddAuthor", "Admin")?pageNumber=${pageNumber}&pageSize=${pageSize}&search=${encodeURIComponent(search)}&sortBy=${encodeURIComponent(sortBy)}`;

                $('#author-list-container').html('<div class="text-center p-20"><i class="icon-spinner2 spinner"></i></div>');
                $.get(url, function (data) {
                    $('#author-list-container').html(data);
                });
            }

            // --- EVENT HANDLERS ---
            $('#author-list-container').on('click', '.pagination a', function(e) { e.preventDefault(); var page = $(this).data('page'); if(page) fetchAuthors(page); });
            $('#author-list-container').on('change', '#page-size-selector', function() { fetchAuthors(1); });
            $('#sort-by').on('change', function() { fetchAuthors(1); });
            $('#search-input').on('input', function() { clearTimeout(debounceTimeout); debounceTimeout = setTimeout(() => fetchAuthors(1), 300); });
        });
    </script>
}
