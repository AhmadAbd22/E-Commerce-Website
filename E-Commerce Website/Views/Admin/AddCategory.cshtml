@model ECommerceWebsite.Models.Dtos.CategoryDto
@{
    ViewData["Title"] = "Manage Categories";
    Layout = "_AdminLayout";

    var isEditing = ViewData["IsEditing"] as bool? == true;
    var currentSearch = ViewData["CurrentSearch"] as string;
    var currentSortBy = ViewData["CurrentSortBy"] as string ?? "name_asc";
    var existingCategories = ViewData["ExistingCategories"] as ECommerceWebsite.Models.Helping_Classes.PagedResult<Category>;
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content"><div class="page-title"><h4><i class="icon-price-tags2 position-left"></i> <span class="text-semibold">Categories</span> - Management</h4></div></div>
    <div class="breadcrumb-line"><ul class="breadcrumb"><li><a href="@Url.Action("Admin", "Admin")"><i class="icon-home2 position-left"></i> Admin</a></li><li class="active">Categories</li></ul></div>
</div>

<div class="content">
    <div class="row">

        <!-- Left column: Add/Edit Category Form -->
        <div class="col-md-4">
            <form action="@(isEditing ? Url.Action("EditCategory", "Admin") : Url.Action("AddCategory", "Admin"))" method="post">
                @if (isEditing)
                {
                    <input type="hidden" name="Id" value="@Model?.Id" />
                }
                <div class="panel panel-flat">
                    <div class="panel-heading"><h5 class="panel-title text-semibold">@(isEditing ? "Edit Category" : "Add New Category")</h5></div>
                    <div class="panel-body">
                        <div class="form-group has-feedback">
                            <label class="text-semibold">Category Name:</label>
                            <input type="text" name="CategoryType" value="@Model?.CategoryType" class="form-control" placeholder="e.g., Science Fiction" required>
                            <div class="form-control-feedback"><i class="glyphicon glyphicon-tag"></i></div>
                            @if (ViewData["EmptyFields"] != null)
                            {
                                <span class="help-block text-danger">@ViewData["EmptyFields"]</span>
                            }
                            @if (ViewData["CategoryExists"] != null)
                            {
                                <span class="help-block text-danger">@ViewData["CategoryExists"]</span>
                            }
                        </div>
                        <div class="text-right">
                            @if (isEditing)
                            {
                                <a href="@Url.Action("AddCategory", "Admin")" class="btn btn-default">Cancel</a>
                            }
                            <button type="submit" class="btn btn-primary">@(isEditing ? "Update" : "Add") Category  <i class="glyphicon glyphicon-floppy-disk"></i></button>
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <!-- Right column: Category List -->
        <div class="col-md-8">
            <div class="panel panel-flat">
                <div class="panel-heading"><h5 class="panel-title text-semibold">Existing Categories</h5></div>
                <div class="panel-body">
                    <!-- Filter and Sort Controls -->
                    <div class="row">
                        <div class="col-md-6">
                            <input type="search" id="search-input" class="form-control" placeholder="Search categories..." value="@currentSearch">
                        </div>
                        <div class="col-md-6">
                            <select id="sort-by" class="form-control">
                                <option value="name_asc" selected="@(currentSortBy == "name_asc")">Sort by Name (A-Z)</option>
                                <option value="name_desc" selected="@(currentSortBy == "name_desc")">Sort by Name (Z-A)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div id="category-list-container">
                    @if (existingCategories != null)
                    {
                        @await Html.PartialAsync("_CategoryListPartial", existingCategories)
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(function() {
            var debounceTimeout;

            function fetchCategories(pageNumber) {
                var search = $('#search-input').val();
                var sortBy = $('#sort-by').val();
                var pageSize = $('#category-list-container #page-size-selector').val() || 10;
                var url = `@Url.Action("AddCategory", "Admin")?pageNumber=${pageNumber}&pageSize=${pageSize}&search=${encodeURIComponent(search)}&sortBy=${encodeURIComponent(sortBy)}`;

                $('#category-list-container').html('<div class="text-center p-20"><i class="icon-spinner2 spinner"></i></div>');
                $.get(url, function (data) {
                    $('#category-list-container').html(data);
                });
            }

            // --- EVENT HANDLERS ---
            $('#category-list-container').on('click', '.pagination a', function(e) { e.preventDefault(); var page = $(this).data('page'); if(page) fetchCategories(page); });
            $('#category-list-container').on('change', '#page-size-selector', function() { fetchCategories(1); });
            $('#sort-by').on('change', function() { fetchCategories(1); });
            $('#search-input').on('input', function() { clearTimeout(debounceTimeout); debounceTimeout = setTimeout(() => fetchCategories(1), 300); });
        });
    </script>
}