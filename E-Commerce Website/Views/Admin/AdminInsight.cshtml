
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4><i class="icon-home4 position-left"></i> <span class="text-semibold">Home</span> - Dashboard</h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Dashboard", "Admin")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li class="active">Dashboard</li>
        </ul>
    </div>
</div>
<!-- /page header -->

<!-- Content area -->
<div class="content">

    <!-- KPI cards -->
    <div class="row">
        <div class="col-lg-4">
            <div class="panel bg-blue-400">
                <div class="panel-body">
                    <div class="heading-elements">
                        <i class="icon-cash3 icon-3x"></i>
                    </div>
                    <h3 class="no-margin">@Model.TotalSalesThisMonth.ToString("C")</h3>
                    Total Sales This Month
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel bg-teal-400">
                <div class="panel-body">
                    <div class="heading-elements">
                        <i class="icon-cart icon-3x"></i>
                    </div>
                    <h3 class="no-margin">@Model.TotalOrders</h3>
                    Total Orders
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel bg-danger-400">
                <div class="panel-body">
                    <div class="heading-elements">
                        <i class="icon-warning22 icon-3x"></i>
                    </div>
                    <h3 class="no-margin">@Model.LowStockItemsCount</h3>
                    Items with Low Stock
                </div>
            </div>
        </div>
    </div>
    <!-- /KPI cards -->

    <!-- Main content row -->
    <div class="row">
        <div class="col-lg-7">
            <!-- Sales Trends Chart -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h6 class="panel-title">Sales Trends</h6>
                </div>
                <div class="panel-body">
                    <!-- This div is where the chart will be rendered -->
                    <div class="chart-container">
                        <div class="chart" id="sales_trends_chart" style="height: 350px;"></div>
                    </div>
                </div>
            </div>
            <!-- /sales trends chart -->
        </div>

        <div class="col-lg-5">
            <!-- Low Stock Alerts -->
            <div class="panel panel-flat">
                <div class="panel-heading">
                    <h6 class="panel-title">Low Stock Alerts</h6>
                </div>
                <div class="table-responsive">
                    <table class="table text-nowrap">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th class="col-md-3">Category</th>
                                <th class="col-md-2">Stock</th>
                                <th class="col-md-2">Status</th>
                                <th class="text-center" style="width: 20px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var product in Model.LowStockProducts)
                            {
                                    <tr>
                                        <td>
                                            <div class="media-left media-middle">
                                                <a href="#" class="btn bg-primary-400 btn-rounded btn-icon btn-xs">
                                                    <span class="letter-icon">@product.ProductName.First()</span>
                                                </a>
                                            </div>
                                            <div class="media-body">
                                                <a href="#" class="display-inline-block text-default text-semibold letter-icon-title">@product.ProductName</a>
                                            </div>
                                        </td>
                                        <td>@product.Category</td>
                                        <td><h6 class="text-semibold no-margin">@product.CurrentStock</h6></td>
                                        <td>
                                        @if (product.Status == "Critical")
                                        {
                                                    <span class="label bg-danger">@product.Status</span>
                                        }
                                        else
                                        {
                                                    <span class="label bg-warning">@product.Status</span>
                                        }
                                        </td>
                                        <td class="text-center">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="restockItem(@product.ProductId)">Restock</button>
                                        </td>
                                    </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- /low stock alerts -->
        </div>
    </div>
    <!-- /main content row -->

</div>
<!-- /content area -->

@section Scripts {
        <!-- ECharts Library (using a CDN for simplicity) -->
        <script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/echarts/5.4.3/echarts.min.js"></script>

        <script type="text/javascript">
            $(function () {
                // --- Sales Chart Initialization ---
                var salesChartElement = document.getElementById('sales_trends_chart');
                if (salesChartElement) {
                    var salesChart = echarts.init(salesChartElement);

                    // Get data from the ViewModel (serialized as JSON)
                    var salesData = @Html.Raw(Json.Serialize(Model.SalesTrendData));

                    // Extract periods and totals for the chart axes
                    var periods = salesData.map(item => item.period);
                    var totals = salesData.map(item => item.salesTotal);

                    salesChart.setOption({
                        // Grid and Axes Styling
                        grid: { left: '3%', right: '4%', bottom: '3%', containLabel: true },
                        xAxis: [{
                            type: 'category',
                            boundaryGap: false,
                            data: periods,
                            axisLine: { lineStyle: { color: '#999' } }
                        }],
                        yAxis: [{
                            type: 'value',
                            axisLabel: { formatter: '${value}' },
                            axisLine: { lineStyle: { color: '#999' } }
                        }],

                        // Tooltip for Hover Effect
                        tooltip: {
                            trigger: 'axis',
                            formatter: '<b>{b0}</b><br/>Sales: ${c0}'
                        },

                        // Series (the actual line)
                        series: [{
                            name: 'Sales',
                            type: 'line',
                            smooth: true, // Makes the line curved
                            areaStyle: {}, // Fills the area below the line
                            itemStyle: { color: '#2196F3' }, // Blue color from theme
                            data: totals
                        }]
                    });
                }

                // --- Interactivity for Restock Button ---
                window.restockItem = function (productId) {
                    // In a real application, this would open a modal or navigate to a restock page.
                    alert('Restock initiated for Product ID: ' + productId);
                }
            });
        </script>
}