@model ECommerceWebsite.Models.Helping_Classes.PagedResult<BookDto>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";

    // Get filter values from ViewData to repopulate the form
    string currentSearch = ViewData["Search"] as string ?? "";
    Guid? currentAuthorId = ViewData["AuthorId"] as Guid?;
    Guid? currentCategoryId = ViewData["CategoryId"] as Guid?;
    decimal? currentMinPrice = ViewData["MinPrice"] as decimal?;
    decimal? currentMaxPrice = ViewData["MaxPrice"] as decimal?;
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4>
                <i class="icon-arrow-left52 position-left"></i>
                <span class="text-semibold">Admin</span> - Book Management
            </h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Admin", "Admin")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li class="active">All Books</li>
        </ul>
    </div>
</div>
<!-- /page header -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        @TempData["Error"]
    </div>
}

<!-- Content area -->
<div class="content">
    <!-- Search and filter form -->
    <div class="panel panel-flat">
        <div class="panel-body">
            <!-- NOTE: The form method is now GET for better UX (bookmarkable URLs) -->
            <form asp-action="Admin" method="get" id="filter-form">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="text-semibold">Search by Title/Author</label>
                            <input type="search" name="search" id="search-input" class="form-control" placeholder="Type to search..." value="@currentSearch">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="text-semibold">By Author</label>
                            <select name="authorId" id="author-filter" class="form-control" asp-items="@(new SelectList((IEnumerable<Author>)ViewData["Authors"], "Id", "AuthorName", currentAuthorId))">
                                <option value="">All Authors</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="text-semibold">By Category</label>
                            <select name="categoryId" id="category-filter" class="form-control" asp-items="@(new SelectList((IEnumerable<Category>)ViewData["Categories"], "Id", "CategoryType", currentCategoryId))">
                                <option value="">All Categories</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="text-semibold">Price Range</label>
                            <div class="input-group">
                                <input type="number" name="minPrice" id="min-price-filter" placeholder="Min" class="form-control" value="@currentMinPrice">
                                <span class="input-group-addon">-</span>
                                <input type="number" name="maxPrice" id="max-price-filter" placeholder="Max" class="form-control" value="@currentMaxPrice">
                            </div>
                        </div>
                    </div>
                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="display-block">&nbsp;</label>
                            <button type="submit" class="btn bg-blue btn-block">
                                <i class="icon-filter3 position-left"></i> Apply
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- AJAX Updatable Area -->
    <div id="admin-book-container">
        @await Html.PartialAsync("_AdminBookGridPartial", Model)
    </div>
</div>
<!-- /content area -->
@section Scripts {
    <script type="text/javascript">
        $(function() {
            var debounceTimeout;

            function fetchAdminPage(pageNumber) {
                // Get all filter values from the form
                var search = $('#search-input').val();
                var authorId = $('#author-filter').val();
                var categoryId = $('#category-filter').val();
                var minPrice = $('#min-price-filter').val();
                var maxPrice = $('#max-price-filter').val();

                // Construct the URL with all parameters
                var url = '@Url.Action("Admin", "Admin")' +
                    '?pageNumber=' + pageNumber +
                    '&search=' + encodeURIComponent(search) +
                    '&authorId=' + encodeURIComponent(authorId) +
                    '&categoryId=' + encodeURIComponent(categoryId) +
                    '&minPrice=' + encodeURIComponent(minPrice) +
                    '&maxPrice=' + encodeURIComponent(maxPrice);

                // Show a loading indicator
                $('#admin-book-container').html('<div class="panel panel-body text-center"><h4><i class="icon-spinner2 spinner"></i> Loading...</h4></div>');

                // Perform the AJAX GET request
                $.get(url, function(data) {
                    // Replace the content with the response from the server
                    $('#admin-book-container').html(data);
                }).fail(function() {
                    $('#admin-book-container').html('<div class="alert alert-danger">An error occurred while loading data. Please try again.</div>');
                });
            }

            // --- EVENT HANDLERS ---

            // 1. Handle Pagination Clicks
            $('#admin-book-container').on('click', '.pagination a', function(e) {
                e.preventDefault(); // Stop the link from navigating directly
                var page = $(this).data('page');
                if (page) {
                    fetchAdminPage(page);
                }
            });

            // 2. Handle Active Search and Filtering (with Debouncing)
            // This now applies to all filter inputs
            $('#search-input, #min-price-filter, #max-price-filter').on('keyup', function() {
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(function() {
                    fetchAdminPage(1);
                }, 300); // Wait 500ms after the user stops typing
            });

            // Handle dropdown selects immediately on change
            $('#author-filter, #category-filter').on('change', function() {
                 fetchAdminPage(1);
            });

            $('#filter-form').on('submit', function(e) {
                e.preventDefault();
                fetchAdminPage(1); 
            });
        });
    </script>
}