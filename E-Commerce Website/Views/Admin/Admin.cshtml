@model IEnumerable<BookDto>
@{
    bool isDeletedView = (ViewData["IsDeletedView"] as bool?) ?? false;
    ViewData["Title"] = isDeletedView ? "Deleted Books" : "Admin Dashboard";
    Layout = "_AdminLayout";
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4>
                <i class="icon-arrow-left52 position-left"></i>
                <span class="text-semibold">Admin</span> - @(isDeletedView ? "Deleted Books" : "All Books")
            </h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Index", "Home")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li class="active">Book Management</li>
        </ul>
        <!-- Filter Toggle Button -->
        <div class="breadcrumb-elements">
            <button type="button" class="btn btn-link filter-toggle" id="filter-toggle">
                <i class="icon-menu-open position-left"></i> Filters
            </button>
        </div>
    </div>
</div>
<!-- /page header -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        <i class="icon-checkmark position-left"></i>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
        <i class="icon-blocked position-left"></i>
        @TempData["Error"]
    </div>
}

<!-- Content area -->
<div class="content">
    <div class="row">
        <!-- Main content area -->
        <div class="col-lg-9 col-md-8" id="main-content">
            <!-- Search -->
            <div class="panel panel-flat">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-8 col-md-offset-2">
                            <div class="form-group has-feedback has-feedback-left">
                                <input type="search" id="book-search" class="form-control" placeholder="Type to search books...">
                                <div class="form-control-feedback">
                                    <i class="icon-search4 text-size-small text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid of Books -->
            <div class="row book-grid">
                @if (!Model.Any())
                {
                    <div class="col-xs-12">
                        <div class="panel panel-flat">
                            <div class="panel-body text-center">
                                <i class="icon-book icon-3x text-muted mb-20"></i>
                                <h4 class="text-muted">No books found</h4>
                                <p class="text-muted">
                                    @if (isDeletedView)
                                    {
                                        <text>No deleted books to display.</text>
                                    }
                                    else
                                    {
                                        <text>Start by adding some books to your inventory.</text>
                                    }
                                </p>
                                @if (!isDeletedView)
                                {
                                    <p class="text-muted">Use the sidebar to add your first book.</p>
                                }
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var book in Model)
                    {
                        @await Html.PartialAsync("_AdminBookCardPartial", book)
                    }
                }

                <div class="col-xs-12" id="no-results-message" style="display: none;">
                    <div class="alert alert-warning text-center">
                        <i class="icon-notification2 position-left"></i>
                        No books found matching your search term.
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Filter Sidebar -->
        <div class="col-lg-3 col-md-4" id="filter-sidebar">
            <div class="sidebar-fixed">
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="icon-filter3 position-left"></i>
                            Filter Products
                            <button type="button" class="btn btn-link btn-xs pull-right filter-close" id="filter-close">
                                <i class="icon-cross2"></i>
                            </button>
                        </h6>
                    </div>
                    <div class="panel-body">
                        <form action="@Url.Action("FilterByAuthor", "Admin")" method="get">
                            <div class="form-group">
                                <label class="text-semibold">By Author</label>
                                <select name="authorId" class="form-control">
                                    <option value="">All Authors</option>
                                    @if (ViewData["Authors"] is IEnumerable<Author> authors)
                                    {
                                        foreach (var author in authors)
                                        {
                                            <option value="@author.Id">@author.AuthorName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="text-semibold">By Price Range</label>
                                <div class="row">
                                    <div class="col-xs-6">
                                        <input type="number" name="minPrice" placeholder="Min" class="form-control" step="50">
                                    </div>
                                    <div class="col-xs-6">
                                        <input type="number" name="maxPrice" placeholder="Max" class="form-control" step="50">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <button type="submit" class="btn bg-blue btn-block">
                                    <i class="icon-filter3 position-left"></i> Apply Filters
                                </button>
                                <button type="button" id="clear-filters" class="btn btn-default btn-block mt-10">
                                    <i class="icon-reset position-left"></i> Clear Filters
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /content area -->
@section Styles {
    <style>
        /* Filter Sidebar Styles */
        #filter-sidebar {
            transition: all 0.3s ease;
        }

        .sidebar-fixed {
            position: sticky;
            top: 20px;
            z-index: 100;
        }

        .filter-toggle, .filter-close {
            color: #fff;
            border: none;
            background: transparent;
            padding: 8px 15px;
        }

            .filter-toggle:hover, .filter-close:hover {
                background-color: rgba(255, 255, 255, 0.1);
                color: #fff;
            }

        .filter-close {
            color: #666;
            padding: 2px 8px;
        }

            .filter-close:hover {
                background-color: #f5f5f5;
                color: #333;
            }
    </style>
}

@section Scripts {
    <script type="text/javascript">
        $(function() {
            // Filter sidebar toggle functionality
            $('#filter-toggle').on('click', function() {
                $('#filter-sidebar').addClass('active');
                $('body').append('<div class="sidebar-backdrop"></div>');
                $('.sidebar-backdrop').addClass('active');
                $('#main-content').addClass('sidebar-open');
            });

            // Close filter sidebar
            $('#filter-close, .sidebar-backdrop').on('click', function() {
                $('#filter-sidebar').removeClass('active');
                $('.sidebar-backdrop').removeClass('active');
                $('#main-content').removeClass('sidebar-open');
                setTimeout(function() {
                    $('.sidebar-backdrop').remove();
                }, 300);
            });

            // Close sidebar on escape key
            $(document).on('keyup', function(e) {
                if (e.keyCode === 27) { // Escape key
                    $('#filter-close').click();
                }
            });

            // Active Search Implementation
            $('#book-search').on('keyup', function() {
                var searchTerm = $(this).val().toLowerCase();
                var visibleCount = 0;

                // Loop through each book card container in the grid
                $('.book-grid > div').each(function() {
                    var bookCard = $(this);
                    var bookText = bookCard.text().toLowerCase();

                    // Check if the card's text contains the search term
                    if (bookText.indexOf(searchTerm) > -1) {
                        bookCard.show();
                        visibleCount++;
                    } else {
                        bookCard.hide();
                    }
                });

                // Show or hide the 'no results' message
                if (visibleCount === 0) {
                    $('#no-results-message').show();
                } else {
                    $('#no-results-message').hide();
                }
            });

            // Clear Filters functionality
            $('#clear-filters').on('click', function() {
                // Clear all form inputs
                $('select[name="authorId"]').val('');
                $('input[name="minPrice"]').val('');
                $('input[name="maxPrice"]').val('');

                // Clear search input
                $('#book-search').val('');

                // Show all books
                $('.book-grid > div').show();
                $('#no-results-message').hide();

                // Redirect to clear filters on server side
                window.location.href = '@Url.Action("Admin", "Admin")';
            });
        });
    </script>
}