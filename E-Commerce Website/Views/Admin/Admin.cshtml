@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<BookDto>
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";

    string currentSearch = ViewData["Search"] as string ?? "";
    Guid? currentAuthorId = ViewData["AuthorId"] as Guid?;
    Guid? currentCategoryId = ViewData["CategoryId"] as Guid?;
    decimal? currentMinPrice = ViewData["MinPrice"] as decimal?;
    decimal? currentMaxPrice = ViewData["MaxPrice"] as decimal?;
    string currentSortBy = ViewData["SortBy"] as string ?? "";
    string currentSortOrder = ViewData["SortOrder"] as string ?? "";
    IEnumerable<Author> authors = ViewData["Authors"] as IEnumerable<Author> ?? new List<Author>();
    IEnumerable<Category> categories = ViewData["Categories"] as IEnumerable<Category> ?? new List<Category>();
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4>
                <i class="icon-arrow-left52 position-left"></i>
                <span class="text-semibold">Admin</span> - Book Management
            </h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Admin", "Admin")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li class="active">All Books</li>
        </ul>
    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">
    <!-- Sort and filter panel -->
    <div class="panel panel-flat">
        <div class="panel-heading">
            <h6 class="panel-title">
                <i class="icon-filter4 position-left"></i>
                Search, Filter & Sort Options
            </h6>
        </div>
        <div class="panel-body">
            <!-- Sort Dropdown -->
            <div class="row mb-15">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="text-semibold">
                            <i class="icon-sort-amount-asc position-left"></i>
                            Sort By
                        </label>
                        <select id="sort-dropdown" class="select-picker" data-live-search="true" data-width="100%">
                            @{
                                string currentSort = !string.IsNullOrEmpty(currentSortBy) ? $"{currentSortBy}|{currentSortOrder}" : "";
                            }
                            <option value="" selected="@(string.IsNullOrEmpty(currentSortBy))">Default (Newest First)</option>
                            <option value="title|asc" selected="@(currentSort == "title|asc")">Title (A-Z)</option>
                            <option value="title|desc" selected="@(currentSort == "title|desc")">Title (Z-A)</option>
                            <option value="author|asc" selected="@(currentSort == "author|asc")">Author (A-Z)</option>
                            <option value="author|desc" selected="@(currentSort == "author|desc")">Author (Z-A)</option>
                            <option value="category|asc" selected="@(currentSort == "category|asc")">Category (A-Z)</option>
                            <option value="category|desc" selected="@(currentSort == "category|desc")">Category (Z-A)</option>
                            <option value="price|asc" selected="@(currentSort == "price|asc")">Price (Low to High)</option>
                            <option value="price|desc" selected="@(currentSort == "price|desc")">Price (High to Low)</option>
                            <option value="date|desc" selected="@(currentSort == "date|desc")">Date (Newest First)</option>
                            <option value="date|asc" selected="@(currentSort == "date|asc")">Date (Oldest First)</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-9 text-right">
                    <button type="button" id="clear-all-btn" class="btn btn-default">
                        <i class="icon-reset position-left"></i>
                        Clear All
                    </button>
                </div>
            </div>

            <hr class="content-divider">

            <!-- Search and Filter Form -->
            <form action="@Url.Action("Admin","Admin")" method="get" id="filter-form">
                <div class="row">
                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="text-semibold">
                                <i class="icon-search4 position-left"></i>
                                Search by Title/Author
                            </label>
                            <input type="search" name="search" id="search-input" class="form-control"
                                   placeholder="Type to search..." value="@currentSearch">
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="text-semibold">By Author</label>
                            <select name="authorId" id="author-filter" class="select-picker" data-live-search="true" data-width="100%">
                                <option value="">All Authors</option>
                                @foreach (var author in authors)
                                {
                                    <option value="@author.Id" selected="@(author.Id == currentAuthorId)">
                                        @author.AuthorName
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-2">
                        <div class="form-group">
                            <label class="text-semibold">By Category</label>
                            <select name="categoryId" id="category-filter" class="select-picker" data-live-search="true" data-width="100%">
                                <option value="">All Categories</option>
                                @foreach (var category in categories)
                                {
                                    <option value="@category.Id" selected="@(category.Id == currentCategoryId)">
                                        @category.CategoryType
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="form-group">
                            <label class="text-semibold">Price Range</label>
                            <div class="input-group">
                                <input type="number" name="minPrice" id="min-price-filter" placeholder="Min"
                                       class="form-control price-input" value="@currentMinPrice" min="0" step="10">
                                <span class="input-group-addon">-</span>
                                <input type="number" name="maxPrice" id="max-price-filter" placeholder="Max"
                                       class="form-control price-input" value="@currentMaxPrice" min="0" step="10">
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- AJAX Updatable Area -->
    <div id="admin-book-container">
        @await Html.PartialAsync("_AdminBookGridPartial", Model)
    </div>
</div>

<!-- Details Modal -->
<div id="modal_book_details" class="modal fade">
    <div class="modal-dialog modal-full" style="margin: 150px auto">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h5 class="modal-title" id="bookModalTitle">Book Details</h5>
            </div>
            <div class="modal-body" id="bookModalBody">
                <div class="text-center"><i class="icon-spinner2 spinner icon-2x"></i></div>
            </div>
            <div class="modal-footer" id="bookModalFooter">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteBookModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog" style="margin: 300px auto">
        <div class="modal-content">
            <form id="deleteBookForm" method="post" action="@Url.Action("Delete", "Admin")">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">×</button>
                    <h3 class="modal-title">Delete Book</h3>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="deleteBookId" name="Id" />
                    <h4 id="deleteBookMessage" class="text-danger"></h4>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>
</div>


<!-- /content area -->
@section Scripts {
    <script type="text/javascript">
        $(function () {

            // --- REUSABLE PLUGIN INITIALIZER ---
            function initializePlugins(container) {
                // activate all themed selects within the given container
                container.find('.select-picker').selectpicker();
                // tooltips (if any)
                container.find('[data-popup="tooltip"]').tooltip();
            }

            // Initialize STATIC controls at first load
            // (keep these because some controls are outside #admin-book-container)
            $('#sort-dropdown').selectpicker();
            $('#author-filter').selectpicker();
            $('#category-filter').selectpicker();

            // Also run the generic initializer on the whole page once
            initializePlugins($(document.body));

            var debounceTimeout;
             $(function() {
            var debounceTimeout;

            // Get current sort values
            function getCurrentSortValues() {
                var sortValue = $('#sort-dropdown').val();
                if (!sortValue) return { sortBy: '', sortOrder: '' };

                var parts = sortValue.split('|');
                return {
                    sortBy: parts[0] || '',
                    sortOrder: parts[1] || ''
                };
            }

            // Price input validation function
            function validatePriceInput(input) {
                var value = parseFloat(input.val());
                if (value < 0 || isNaN(value)) {
                    input.val('');
                    return false;
                }
                return true;
            }

            // Reusable function to fetch results from the server
            function fetchAdminPage(pageNumber) {
                var search = $('#search-input').val();
                var authorId = $('#author-filter').val();
                var categoryId = $('#category-filter').val();
                var minPrice = $('#min-price-filter').val();
                var maxPrice = $('#max-price-filter').val();
                var sortValues = getCurrentSortValues();
                var pageSize = $('#admin-book-container #page-size-selector').val() || 9;

                // Validate price inputs before making request
                if (minPrice && parseFloat(minPrice) < 0) {
                    $('#min-price-filter').val('');
                    minPrice = '';
                }
                if (maxPrice && parseFloat(maxPrice) < 0) {
                    $('#max-price-filter').val('');
                    maxPrice = '';
                }

                var url = '@Url.Action("Admin", "Admin")' +
                    '?pageNumber=' + pageNumber +
                    '&pageSize=' + pageSize +
                    '&search=' + encodeURIComponent(search) +
                    '&authorId=' + encodeURIComponent(authorId) +
                    '&categoryId=' + encodeURIComponent(categoryId) +
                    '&minPrice=' + encodeURIComponent(minPrice) +
                    '&maxPrice=' + encodeURIComponent(maxPrice) +
                    '&sortBy=' + encodeURIComponent(sortValues.sortBy) +
                    '&sortOrder=' + encodeURIComponent(sortValues.sortOrder);

                $('#admin-book-container').html('<div class="panel panel-body text-center"><h4><i class="icon-spinner2 spinner"></i> Loading...</h4></div>');

                $.get(url, function(data) {
                    $('#admin-book-container').html(data);
                }).fail(function() {
                    $('#admin-book-container').html('<div class="alert alert-danger">An error occurred while loading data.</div>');
                });
            }

            // --- EVENT HANDLERS ---

            // Sort dropdown change
            $('#sort-dropdown').on('change', function() {
                fetchAdminPage(1);
            });

            // Clear all filters and sorting
            $('#clear-all-btn').on('click', function() {
                $('#search-input').val('');
                $('#author-filter').val('');
                $('#category-filter').val('');
                $('#min-price-filter').val('');
                $('#max-price-filter').val('');
                $('#sort-dropdown').val('');
                fetchAdminPage(1);
            });

            // Pagination clicks
            $('#admin-book-container').on('click', '.pagination a', function(e) {
                e.preventDefault();
                var page = $(this).data('page');
                if (page) {
                    fetchAdminPage(page);
                }
            });

            // Search and price inputs with debounce
            $('#search-input, #min-price-filter, #max-price-filter').on('input', function() {
                if ($(this).hasClass('price-input')) {
                    validatePriceInput($(this));
                }

                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(function() {
                    fetchAdminPage(1);
                }, 300);
            });

            // Filter dropdowns
            $('#author-filter, #category-filter').on('change', function() {
                fetchAdminPage(1);
            });

            // Price input validation and restrictions
            $('.price-input').on('input', function() {
                var $this = $(this);
                var value = $this.val();

                value = value.replace(/[^0-9.]/g, '');
                var parts = value.split('.');
                if (parts.length > 2) {
                    value = parts[0] + '.' + parts.slice(1).join('');
                }

                $this.val(value);

                var numValue = parseFloat(value);
                if (numValue < 0) {
                    $this.val('');
                }
            });

            // Prevent negative key inputs
            $('.price-input').on('keydown', function(e) {
                if ($.inArray(e.keyCode, [46, 8, 9, 27, 13]) !== -1 ||
                    (e.keyCode === 65 && e.ctrlKey === true) ||
                    (e.keyCode === 67 && e.ctrlKey === true) ||
                    (e.keyCode === 86 && e.ctrlKey === true) ||
                    (e.keyCode === 88 && e.ctrlKey === true) ||
                    (e.keyCode >= 35 && e.keyCode <= 40)) {
                    return;
                }

                if (e.keyCode === 109 || e.keyCode === 173 || e.keyCode === 189) {
                    e.preventDefault();
                    return;
                }

                if ((e.shiftKey || (e.keyCode < 48 || e.keyCode > 57)) &&
                    (e.keyCode < 96 || e.keyCode > 105) &&
                    e.keyCode !== 190 && e.keyCode !== 110) {
                    e.preventDefault();
                }
            });

            // Form submission prevention
            $('#filter-form').on('submit', function(e) {
                e.preventDefault();
                fetchAdminPage(1);
            });

             $('#admin-book-container').on('change', '#page-size-selector', function() {
                fetchAdminPage(1);
            });
        });

            // --- MAIN AJAX FUNCTION ---
            function fetchAdminPage(pageNumber) {
                var search = $('#search-input').val();
                var authorId = $('#author-filter').val();
                var categoryId = $('#category-filter').val();
                var minPrice = $('#min-price-filter').val();
                var maxPrice = $('#max-price-filter').val();
                var pageSize = $('#admin-book-container #page-size-selector').val() || 10;
                var sortValue = $('#sort-dropdown').val();
                var sortParts = sortValue ? sortValue.split('|') : ['', ''];
                var sortBy = sortParts[0];
                var sortOrder = sortParts[1];

                var url = `@Url.Action("Admin", "Admin")?pageNumber=${pageNumber}&pageSize=${pageSize}&search=${encodeURIComponent(search)}&authorId=${encodeURIComponent(authorId)}&categoryId=${encodeURIComponent(categoryId)}&minPrice=${encodeURIComponent(minPrice)}&maxPrice=${encodeURIComponent(maxPrice)}&sortBy=${encodeURIComponent(sortBy)}&sortOrder=${encodeURIComponent(sortOrder)}`;

                $('#admin-book-container').html('<div class="panel panel-body text-center"><h4><i class="icon-spinner2 spinner"></i> Loading...</h4></div>');

                $.get(url, function (data) {
                    $('#admin-book-container').html(data);
                    // Re-init plugins for any new controls inside the partial
                    initializePlugins($('#admin-book-container'));
                }).fail(function () {
                    $('#admin-book-container').html('<div class="alert alert-danger">An error occurred while loading data.</div>');
                });
            }

            // --- EVENT HANDLERS ---

            // Static elements
            $('#sort-dropdown, #author-filter, #category-filter').on('change', function () {
                fetchAdminPage(1);
            });

            $('#search-input, #min-price-filter, #max-price-filter').on('input', function () {
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(function () { fetchAdminPage(1); }, 300);
            });

            $('#clear-all-btn').on('click', function () {
                // Reset text/number inputs
                $('#search-input').val('');
                $('#min-price-filter').val('');
                $('#max-price-filter').val('');

                // Reset selects (styled)
                $('#sort-dropdown').selectpicker('val', '');
                $('#author-filter').selectpicker('val', '');
                $('#category-filter').selectpicker('val', '');

                fetchAdminPage(1);
            });

            // Delegated handlers for dynamic elements inside the container
            $('#admin-book-container').on('click', '.pagination a', function (e) {
                e.preventDefault();
                var page = $(this).data('page');
                if (page) fetchAdminPage(page);
            });

            $('#admin-book-container').on('change', '#page-size-selector', function () {
                fetchAdminPage(1);
            });

            // View Details modal
            $('#admin-book-container').on('click', '.view-book-btn', function () {
                var bookId = $(this).data('book-id');
                var modalBody = $('#bookModalBody');
                var modalTitle = $('#bookModalTitle');
                var modalFooter = $('#bookModalFooter');

                modalTitle.text('Loading Details...');
                modalBody.html('<div class="text-center"><i class="icon-spinner2 spinner icon-2x"></i></div>');
                modalFooter.find('#dynamicEditButton').remove();

                var url = '@Url.Action("BookDetailsPartial", "Admin")/' + bookId;

                $.get(url, function (data) {
                    var loadedHtml = $(data);
                    var title = loadedHtml.find('h3').first().text();
                    modalTitle.text(title || 'Book Details');
                    modalBody.html(data);

                    var editUrl = '@Url.Action("Edit", "Admin")/' + bookId;
                    var editButtonHtml = '<a href="' + editUrl + '" id="dynamicEditButton" class="btn btn-primary"><i class="icon-pencil position-left"></i> Edit Book</a>';
                    modalFooter.append(editButtonHtml);
                }).fail(function () {
                    modalTitle.text('Error');
                    modalBody.html('<div class="alert alert-danger">Could not load book details. Please try again.</div>');
                });
            });

            // Initial pass for dynamic area
            initializePlugins($('#admin-book-container'));
        });


            $(function () {
            // Delete Book
            $('#book-list-container').on('click', '.delete-book-btn', function () {
                var button = $(this);
                var bookId = button.data('book-id');
                var bookTitle = button.data('book-title');

                var form = $('#bookForm');
                form.attr('action', '@Url.Action("Delete", "Admin")');

                $('#bookModalTitle').text('Delete Book');
                $('#bookModalBodyContent').html(`
                    <p>Are you sure you want to delete the book "<strong>${bookTitle}</strong>"? This action cannot be undone.</p>
                `);
                $('#bookModalSubmitButton').text('Delete').removeClass('btn-primary').addClass('btn-danger');
                $('#bookId').val(bookId);
            });

                    // Delete Book Modal
            $('#admin-book-container').on('click', '.delete-book-btn', function () {
                var button = $(this);
                var bookId = button.data('book-id');
                var bookTitle = button.data('book-title');

                $('#deleteBookId').val(bookId);
                $('#deleteBookMessage').html(`Do you really want to delete the book "<strong>${bookTitle}</strong>"?`);
                $('#deleteBookModal').modal('show');
            });


            // Keep normal POST submit (can switch to AJAX later if needed)
            $('#bookForm').on('submit', function (e) {
                // let it post normally
            });
        });
    </script>
}
