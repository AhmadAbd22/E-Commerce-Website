@model IEnumerable<BookDto>
@{
    ViewData["IsDeletedView"] = true;
    ViewData["Title"] = "Deleted Books";
    Layout = "_MinimumLayout";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>×</span></button>
        <i class="icon-checkmark position-left"></i>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert"><span>×</span></button>
        <i class="icon-blocked position-left"></i>
        @TempData["Error"]
    </div>
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4>
                <i class="icon-arrow-left52 position-left"></i>
                <span class="text-semibold">Admin</span> - Deleted Books
            </h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Admin", "Admin")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li><a href="@Url.Action("Admin", "Admin")">Book Management</a></li>
            <li class="active">Deleted Books</li>
        </ul>
    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">
    <div class="container-detached">
        <div class="content-detached">

            <!-- Actions and search -->
            <div class="panel panel-flat">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-8 col-sm-12">
                            <a href="@Url.Action("Admin", "Admin")" class="btn btn-success"><i class="icon-list position-left"></i> Back to Active Books</a>
                        </div>

                        <!-- Active Search Input -->
                        <div class="col-md-4 col-sm-12">
                            <div class="form-group has-feedback has-feedback-left">
                                <input type="search" id="deleted-book-search" class="form-control" placeholder="Type to search deleted books...">
                                <div class="form-control-feedback">
                                    <i class="icon-search4 text-size-small text-muted"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid of Deleted Books -->
            <div class="row book-grid">
                @if (!Model.Any())
                {
                    <div class="col-xs-12">
                        <div class="panel panel-flat">
                            <div class="panel-body text-center">
                                <i class="icon-trash icon-3x text-muted mb-20"></i>
                                <h4 class="text-muted">Recycle Bin is Empty</h4>
                                <p class="text-muted">There are no deleted books to display.</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var book in Model)
                    {
                        @await Html.PartialAsync("_AdminBookCardPartial", book)
                    }
                }
                <!-- This is the message that will show if no search results are found -->
                <div class="col-xs-12" id="no-results-message" style="display: none;">
                    <div class="alert alert-warning text-center">
                        <i class="icon-notification2 position-left"></i>
                        No deleted books found matching your search term.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Detached sidebar (reused for consistent layout) -->
    <div class="sidebar-detached">
        <div class="sidebar sidebar-default sidebar-separate">
            <div class="sidebar-content">
                <div class="sidebar-category">
                    <div class="category-title"><span>Filter Deleted Books</span></div>
                    <div class="category-content">
                        <form action="@Url.Action("FilterByAuthor", "Admin")" method="get">
                            <div class="form-group">
                                <legend class="text-size-mini text-muted no-border no-padding">By Author</legend>
                                <select name="authorId" class="form-control">
                                    <option value="">All Authors</option>
                                    @if (ViewData["Authors"] is IEnumerable<Author> authors)
                                    {
                                        @foreach (var author in authors)
                                        {
                                            <option value="@author.Id">@author.AuthorName</option>
                                        }
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn bg-blue btn-block">Filter <i class="icon-filter3 position-right"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /content area -->
@section Scripts {
    <script type="text/javascript">
        $(function() {
            $('#deleted-book-search').on('keyup', function() {
                var searchTerm = $(this).val().toLowerCase();
                var visibleCount = 0;

                $('.book-grid > div').each(function() {
                    var bookCard = $(this);
                    if (bookCard.find('.admin-book-card').length > 0) {
                        var bookText = bookCard.text().toLowerCase();
                        if (bookText.indexOf(searchTerm) > -1) {
                            bookCard.show();
                            visibleCount++;
                        } else {
                            bookCard.hide();
                        }
                    }
                });

                if (visibleCount === 0 && $('#deleted-book-search').val().length > 0) {
                    $('#no-results-message').show();
                } else {
                    $('#no-results-message').hide();
                }
            });
        });
    </script>
}