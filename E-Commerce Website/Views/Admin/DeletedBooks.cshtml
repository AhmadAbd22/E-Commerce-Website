@model IEnumerable<BookDto>
@{
    ViewData["IsDeletedView"] = true;
    ViewData["Title"] = "Deleted Books";

    string currentSearch = ViewData["Search"] as string ?? "";
    Guid? currentAuthorId = ViewData["AuthorId"] as Guid?;
    Guid? currentCategoryId = ViewData["CategoryId"] as Guid?;
    decimal? currentMinPrice = ViewData["MinPrice"] as decimal?;
    decimal? currentMaxPrice = ViewData["MaxPrice"] as decimal?;

    Layout = "_AdminLayout";
}

<!-- Page header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4>
                <i class="icon-arrow-left52 position-left"></i>
                <span class="text-semibold">Admin</span> - Deleted Books
            </h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("Admin", "Admin")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li><a href="@Url.Action("Admin", "Admin")">Book Management</a></li>
            <li class="active">Deleted Books</li>
        </ul>
    </div>
</div>
<!-- /page header -->
<!-- Search and filter form -->
<div class="panel panel-flat">
    <div class="panel-body">
        <form action="@Url.Action("Admin","Admin")" method="get" id="filter-form">
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="text-semibold">Search by Title/Author</label>
                        <input type="search" name="search" id="search-input" class="form-control" placeholder="Type to search..." value="@currentSearch">
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="text-semibold">By Author</label>
                        <select name="authorId" id="author-filter" class="form-control select-picker" dropdown-menu>
                            <option value="">All Authors</option>
                            @if (ViewData["Authors"] is IEnumerable<Author> authors)
                            {
                                foreach (var author in authors)
                                {
                                    if (author.Id == currentAuthorId)
                                    {
                                        <option value="@author.Id" selected>@author.AuthorName</option>
                                    }
                                    else
                                    {
                                        <option value="@author.Id">@author.AuthorName</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="text-semibold">By Category</label>
                        <select name="categoryId" id="category-filter" class="form-control select-picker" required>
                            <option value="">All Categories</option>
                            @if (ViewData["Categories"] is IEnumerable<Category> categories)
                            {
                                foreach (var category in categories)
                                {
                                    if (category.Id == currentCategoryId)
                                    {
                                        <option value="@category.Id" selected>@category.CategoryType</option>
                                    }
                                    else
                                    {
                                        <option value="@category.Id">@category.CategoryType</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="form-group">
                        <label class="text-semibold">Price Range</label>
                        <div class="input-group">
                            <input type="number" name="minPrice" id="min-price-filter" placeholder="Min" class="form-control price-input" value="@currentMinPrice" min="0" step="10">
                            <span class="input-group-addon">-</span>
                            <input type="number" name="maxPrice" id="max-price-filter" placeholder="Max" class="form-control price-input" value="@currentMaxPrice min="0" step="10">
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Content area -->
<div class="content">
    <div class="container-detached">
        <div class="content-detached">
            <!-- Grid of Deleted Books -->
            <div class="row book-grid">
                @if (!Model.Any())
                {
                    <div class="col-xs-12">
                        <div class="panel panel-flat">
                            <div class="panel-body text-center">
                                <i class="icon-trash icon-3x text-muted mb-20"></i>
                                <h4 class="text-muted">Recycle Bin is Empty</h4>
                                <p class="text-muted">There are no deleted books to display.</p>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @foreach (var book in Model)
                    {
                        @await Html.PartialAsync("_AdminBookCardPartial", book)
                    }
                }
                <!-- This is the message that will show if no search results are found -->
                <div class="col-xs-12" id="no-results-message" style="display: none;">
                    <div class="alert alert-warning text-center">
                        <i class="icon-notification2 position-left"></i>
                        No deleted books found matching your search term.
                    </div>
                </div>
            </div>
        </div>
    </div>

<!-- /content area -->
@section Scripts {
    <script type="text/javascript">
        $(function() {

                function initializePlugins(container) {
                    // activate all themed selects within the given container
                    container.find('.select-picker').selectpicker();
                    // tooltips (if any)
                    container.find('[data-popup="tooltip"]').tooltip();
                }

                // Initialize STATIC controls at first load
                // (keep these because some controls are outside #admin-book-container)
                $('#sort-dropdown').selectpicker();
                $('#author-filter').selectpicker();
                $('#category-filter').selectpicker();

            $('#deleted-book-search').on('keyup', function() {
                var searchTerm = $(this).val().toLowerCase();
                var visibleCount = 0;

                $('.book-grid > div').each(function() {
                    var bookCard = $(this);
                    if (bookCard.find('.admin-book-card').length > 0) {
                        var bookText = bookCard.text().toLowerCase();
                        if (bookText.indexOf(searchTerm) > -1) {
                            bookCard.show();
                            visibleCount++;
                        } else {
                            bookCard.hide();
                        }
                    }
                });

                if (visibleCount === 0 && $('#deleted-book-search').val().length > 0) {
                    $('#no-results-message').show();
                } else {
                    $('#no-results-message').hide();
                }
            });
        });
    </script>
}