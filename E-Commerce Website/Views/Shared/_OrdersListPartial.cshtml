@using ECommerceWebsite.Models.Helping_Classes
@using ECommerceWebsite.Models.Dtos
@model PagedResult<AdminOrderViewDto>

@{
    // Define the list of possible statuses for the dropdown
    var statuses = new List<SelectListItem>
    {
        new SelectListItem { Value = "Pending", Text = "Pending" },
        new SelectListItem { Value = "Confirmed", Text = "Confirmed" },
        new SelectListItem { Value = "Shipped", Text = "Shipped" },
        new SelectListItem { Value = "Delivered", Text = "Delivered" },
        new SelectListItem { Value = "Cancelled", Text = "Cancelled" }
    };
}


@if (!Model.Items.Any())
{
    <div class="panel panel-flat"><div class="panel-body text-center"><i class="icon-cart-remove icon-3x text-muted"></i><h5 class="text-semibold mt-15">No orders found.</h5></div></div>
}
else
{
    @foreach (var order in Model.Items)
    {
        <div class="panel panel-flat">
            <div class="panel-heading">
                <h6 class="panel-title">Order ID: @order.OrderId.ToString("N").Substring(0, 8).ToUpper()</h6>
                <div class="heading-elements">
                    <span class="label label-info">@order.OrderStatus</span>
                    <span class="text-muted ml-10">Placed on: @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>
            </div>

            <div class="panel-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-semibold">User Details</h6>
                        <dl class="dl-horizontal">
                            <dt>Full Name</dt>
                            <dd>@order.UserFullName</dd>
                            <dt>Address</dt>
                            <dd>@order.ShippingAddress</dd>
                            <dt>City</dt>
                            <dd>@order.City</dd>
                            <dt>Phone</dt>
                            <dd>@order.PhoneNumber</dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-semibold">Order Contents</h6>
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Product Name</th>
                                        <th class="text-center">Quantity</th>
                                        <th class="text-right">Unit Price</th>
                                        <th class="text-right">Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <tr>
                                            <td>@item.BookTitle</td>
                                            <td class="text-center">@item.Quantity</td>
                                            <td class="text-right">@item.UnitPrice.ToString("C")</td>
                                            <td class="text-right">@item.Subtotal.ToString("C")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <hr class="mt-10 mb-10">
                        <div class="text-right">
                            <p>Total Quantity: <span class="text-semibold">@order.TotalQuantity</span></p>
                            <h4>Total Amount: <span class="text-semibold">@order.TotalAmount.ToString("C")</span></h4>
                        </div>
                    </div>
                </div>
            </div>

            <div class="panel-footer">
                <div class="row">
                    <div class="col-md-8">
                        <span class="text-muted">Update order status:</span>
                    </div>
                    <div class="col-md-4 text-right">
                        <form action="@Url.Action("UpdateOrderStatus", "Admin")" method="post" class="form-inline">
                            <input type="hidden" name="orderId" value="@order.OrderId" />
                            <div class="form-group">
                                <select name="status" class="form-control">
                                    @foreach (var statusItem in statuses)
                                    {
                                        <option value="@statusItem.Value" selected="@(order.OrderStatus == statusItem.Value)">
                                            @statusItem.Text
                                        </option>
                                    }
                                </select>
                            </div>
                            <button type="submit" class="btn btn-primary btn-sm ml-5">Update</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <div class="text-center">
            <ul class="pagination pagination-rounded">
                @if (Model.HasPreviousPage)
                {
                    <li><a href="#" data-page="@(Model.CurrentPage - 1)">&larr; &nbsp; Prev</a></li>
                }
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="@(i == Model.CurrentPage ? "active" : "")"><a href="#" data-page="@i">@i</a></li>
                }
                @if (Model.HasNextPage)
                {
                    <li><a href="#" data-page="@(Model.CurrentPage + 1)">Next &nbsp; &rarr;</a></li>
                }
            </ul>
        </div>
    }
}