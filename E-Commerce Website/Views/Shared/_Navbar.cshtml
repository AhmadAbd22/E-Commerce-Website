@{
	var categories = ViewData["Categories"] as IEnumerable<Category>;
	var cartItemCount = ViewBag.CartItemCount ?? 0;
	bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
	bool isLoginView = (ViewData["isLoginView"] as bool?) ?? false;
	string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
	string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
	bool isSignUpPage = currentController == "SignUp" && currentAction == "SignUp";
	bool isLoginPage = currentController == "Login" && currentAction == "Login";
	bool isAdminView = currentController == "Admin";
}

<div class="navbar navbar-inverse bg-indigo">
	<div class="navbar-header">
		<a class="navbar-brand" href="@(isAdminView ? Url.Action("Admin", "Admin") : Url.Action("UserHome", "UserHome"))">
			<img src="~/assets/images/logo_light.png" alt="">
		</a>

		<ul class="nav navbar-nav visible-xs-block">
			<li><a data-toggle="collapse" data-target="#navbar-mobile"><i class="icon-tree5"></i></a></li>
			<li><a class="sidebar-mobile-main-toggle"><i class="icon-paragraph-justify3"></i></a></li>
		</ul>
	</div>

	<div class="navbar-collapse collapse" id="navbar-mobile">
		<!-- Left side - empty for now -->
		<ul class="nav navbar-nav">
		</ul>

		<!-- Right side navigation -->
		<div class="navbar-right">
			<ul class="nav navbar-nav navbar-inline">
				<!-- Welcome message -->
				<li class="navbar-text-item">
					@if (isAuthenticated && !isSignUpPage && !isLoginPage)
					{
						@if (isAdminView)
						{
							<span class="navbar-text">Welcome, Admin!</span>
						}
						else
						{
							<span class="navbar-text">Welcome back!</span>
						}
					}
					else if (isSignUpPage)
					{
						<span class="navbar-text">Join us today!</span>
					}
					else if (isLoginPage)
					{
						<span class="navbar-text">Welcome! Please sign in</span>
					}
					else
					{
						<span class="navbar-text">Welcome! Please login</span>
					}
				</li>

				<!-- User Account Dropdown with Logout Only - show for both authenticated users and admins -->
				@if (isAuthenticated && !isSignUpPage && !isLoginPage)
				{
					<li class="dropdown">
						<a href="#" class="dropdown-toggle" data-toggle="dropdown">
							<i class="icon-user"></i>
							<span class="visible-xs-inline-block position-right">Account</span>
						</a>

						<div class="dropdown-menu dropdown-content">
							<div class="dropdown-content-heading">
								@if (isAdminView)
								{
									<text>Admin Account</text>
								}
								else
								{
									<text>My Account</text>
								}
							</div>

							<ul class="media-list dropdown-content-body width-250">
								<li class="media">
									<div class="media-left">
										<a href="@Url.Action("Logout", "Login")" class="btn bg-danger btn-rounded btn-icon btn-xs">
											<i class="icon-switch2"></i>
										</a>
									</div>
									<div class="media-body">
										<a href="@Url.Action("Logout", "Login")" class="media-heading">
											<span class="text-semibold">Logout</span>
										</a>
										<span class="text-muted">Sign out of your account</span>
									</div>
								</li>
							</ul>
						</div>
					</li>
				}

				<!-- Login/Signup buttons for non-authenticated users -->
				@if (!isAuthenticated)
				{
					@if (isSignUpPage)
					{
						<!-- Show Login button when on SignUp page -->
						<li>
							<a href="@Url.Action("Login", "Login")" class="btn btn-link navbar-btn">
								<i class="icon-enter position-left"></i>
								<span class="hidden-xs">Login</span>
							</a>
						</li>
					}
					else if (isLoginPage)
					{
						<!-- Show Sign Up button when on Login page -->
						<li>
							<a href="@Url.Action("SignUp", "SignUp")" class="btn btn-link navbar-btn">
								<i class="icon-plus3 position-left"></i>
								<span class="hidden-xs">Sign Up</span>
							</a>
						</li>
					}
					else
					{
						<!-- Show Login button on other pages when not authenticated -->
						<li>
							<a href="@Url.Action("Login", "Login")" class="btn btn-link navbar-btn">
								<i class="icon-enter position-left"></i>
								<span class="hidden-xs">Login</span>
							</a>
						</li>
					}
				}
			</ul>
		</div>
	</div>
</div>

@section Styles {
	<style>
		/* Prevent horizontal scrolling */
		.navbar {
			overflow-x: hidden;
		}

		.navbar-right {
			margin-right: 0;
		}

		.cart-nav-item {
			position: relative;
		}

		.cart-badge {
			position: absolute;
			top: 6px;
			right: 2px;
			padding: 2px 6px;
			border-radius: 50%;
			font-size: 10px;
			font-weight: bold;
			min-width: 16px;
			text-align: center;
			animation: pulse 2s infinite;
			box-shadow: 0 0 0 2px #fff;
		}

		.cart-button {
			position: relative;
			display: inline-block;
			margin: 8px 4px;
			padding: 8px 12px;
			border-radius: 4px;
			transition: all 0.3s ease;
			text-decoration: none;
			color: #fff;
		}

			.cart-button:hover {
				background-color: rgba(255, 255, 255, 0.1);
				color: #fff;
				text-decoration: none;
				transform: translateY(-1px);
			}

		/* Inline navbar elements */
		.navbar-inline {
			display: flex;
			align-items: center;
			flex-wrap: nowrap;
			max-width: 100%;
		}

		.navbar-text-item {
			display: flex;
			align-items: center;
			padding: 0 10px;
			white-space: nowrap;
			flex-shrink: 1;
			min-width: 0;
		}

			.navbar-text-item .navbar-text {
				margin: 0;
				padding: 15px 0;
				margin-right: 8px;
				white-space: nowrap;
			}

		.inline-logout {
			margin: 0;
			padding: 6px 12px;
			color: #fff;
			text-decoration: none;
			white-space: nowrap;
			flex-shrink: 0;
		}

			.inline-logout:hover {
				background-color: rgba(255, 255, 255, 0.1);
				color: #fff;
				text-decoration: none;
			}

		/* Dropdown styling for logout */
		.dropdown-content {
			min-width: 250px;
		}

		.dropdown-content-body .media:hover {
			background-color: #f5f5f5;
			border-radius: 4px;
		}

		.dropdown-content-body .media a {
			text-decoration: none;
		}

			.dropdown-content-body .media a:hover {
				text-decoration: none;
			}

	</style>
}

