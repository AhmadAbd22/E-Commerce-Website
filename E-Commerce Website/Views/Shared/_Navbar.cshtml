@{
	var categories = ViewData["Categories"] as IEnumerable<Category>;
	var cartItemCount = ViewBag.CartItemCount ?? 0;
	bool isAuthenticated = User.Identity?.IsAuthenticated ?? false;
	string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
	string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
	bool isSignUpPage = currentController == "SignUp" && currentAction == "SignUp";
}

<div class="navbar navbar-inverse bg-indigo">
	<div class="navbar-header">
		<a class="navbar-brand" href="@Url.Action("UserHome", "UserHome")"><img src="~/assets/images/logo_light.png" alt=""></a>

		<ul class="nav navbar-nav visible-xs-block">
			<li><a data-toggle="collapse" data-target="#navbar-mobile"><i class="icon-tree5"></i></a></li>
			<li><a class="sidebar-mobile-main-toggle"><i class="icon-paragraph-justify3"></i></a></li>
		</ul>
	</div>

	<div class="navbar-collapse collapse" id="navbar-mobile">
		<ul class="nav navbar-nav">
			@if (isAuthenticated && !isSignUpPage)
			{
				<li>
					<a href="@Url.Action("Logout", "Login")" class="btn btn-link navbar-btn">
						<i class="icon-switch2 position-left"></i>
						<span class="hidden-xs">Logout</span>
					</a>
				</li>
			}
			else
			{
				<li>
					<a href="@Url.Action("Login", "Login")" class="btn btn-link navbar-btn">
						<i class="icon-enter position-left"></i>
						<span class="hidden-xs">Login</span>
					</a>
				</li>
			}

			@if (isAuthenticated && !isSignUpPage)
			{
				<li class="cart-nav-item">
					<a href="@Url.Action("ViewCart", "Cart")" class="navbar-btn cart-button" data-popup="tooltip" title="View Shopping Cart">
						<i class="icon-cart2"></i>
						<span class="visible-xs-inline-block">Cart</span>
						@if (cartItemCount > 0)
						{
							<span class="badge bg-danger cart-badge" id="cart-badge">@cartItemCount</span>
						}
					</a>
				</li>
			}

		<div class="navbar-right">
			@if (isAuthenticated && !isSignUpPage)
			{
				<p class="navbar-text">Welcome back!</p>
			}
			else if (isSignUpPage)
			{
				<p class="navbar-text">Join us today!</p>
			}
			else
			{
				<p class="navbar-text">Welcome! Please login</p>
			}

			<ul class="nav navbar-nav">
				@if (isAuthenticated && !isSignUpPage)
				{
					<!-- User Account Dropdown -->
					<li class="dropdown">
						<a href="#" class="dropdown-toggle" data-toggle="dropdown">
							<i class="icon-user"></i>
							<span class="visible-xs-inline-block position-right">Account</span>
						</a>

						<div class="dropdown-menu dropdown-content">
							<div class="dropdown-content-heading">
								My Account
								<ul class="icons-list">
									<li><a href="#"><i class="icon-cog6"></i></a></li>
								</ul>
							</div>

							<ul class="media-list dropdown-content-body width-300">
								<li class="media">
									<div class="media-left">
										<a href="@Url.Action("ViewCart", "Cart")" class="btn bg-success-400 btn-rounded btn-icon btn-xs">
											<i class="icon-cart2"></i>
										</a>
									</div>
									<div class="media-body">
										<a href="@Url.Action("ViewCart", "Cart")" class="media-heading">
											<span class="text-semibold">Shopping Cart</span>
											@if (cartItemCount > 0)
											{
												<span class="badge bg-success pull-right">@cartItemCount</span>
											}
										</a>
										<span class="text-muted">View and manage your cart items</span>
									</div>
								</li>

								<li class="media">
									<div class="media-left">
										<a href="@Url.Action("OrderHistory", "Cart")" class="btn bg-blue btn-rounded btn-icon btn-xs">
											<i class="icon-history"></i>
										</a>
									</div>
									<div class="media-body">
										<a href="@Url.Action("OrderHistory", "Cart")" class="media-heading">
											<span class="text-semibold">Order History</span>
										</a>
										<span class="text-muted">View your past orders</span>
									</div>
								</li>

								<li class="media">
									<div class="media-left">
										<a href="#" class="btn bg-purple-300 btn-rounded btn-icon btn-xs">
											<i class="icon-user"></i>
										</a>
									</div>
									<div class="media-body">
										<a href="#" class="media-heading">
											<span class="text-semibold">Profile Settings</span>
										</a>
										<span class="text-muted">Manage your account</span>
									</div>
								</li>
							</ul>

							<div class="dropdown-content-footer">
								<a href="@Url.Action("Logout", "Login")" data-popup="tooltip" title="Logout">
									<i class="icon-switch2 display-block"></i>
								</a>
							</div>
						</div>
					</li>
				}
				else
				{
					<li>
						<a href="@Url.Action("SignUp", "SignUp")" class="btn btn-success navbar-btn">
							<i class="icon-plus3 position-left"></i>
							<span class="hidden-xs">Sign Up</span>
						</a>
					</li>
				}
			</ul>
		</div>
	</div>
</div>

@section Styles {
	<style>
		.cart-nav-item {
			position: relative;
		}

		.cart-badge {
			position: absolute;
			top: 6px;
			right: 2px;
			padding: 2px 6px;
			border-radius: 50%;
			font-size: 10px;
			font-weight: bold;
			min-width: 16px;
			text-align: center;
			animation: pulse 2s infinite;
			box-shadow: 0 0 0 2px #fff;
		}


		.cart-button {
			position: relative;
			display: inline-block;
			margin: 8px 4px;
			padding: 8px 12px;
			border-radius: 4px;
			transition: all 0.3s ease;
			text-decoration: none;
			color: #fff;
		}

		.cart-button:hover {
			background-color: rgba(255, 255, 255, 0.1);
			color: #fff;
			text-decoration: none;
			transform: translateY(-1px);
		}
	</style>
}