@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<Category>

<div class="table-responsive border-top-lg border-top-primary">
    <table class="table table-hover">
        <thead>
            <tr class="bg-blue">
                <th>Category Name</th>
                <th class="text-center text-size-large" style="width: 100px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">No categories found.</td>
                </tr>
            }
            @foreach (var category in Model.Items)
            {
                <tr class="text-size-large">
                    <td class="col-md-10">@category.CategoryType</td>
                    <td class="text-center col-md-2">
                        <ul class="icons-list">
                            <li class="text-primary-600">
                                <button type="button" class="btn btn-link edit-category-btn" data-toggle="modal" data-target="#categoryModal"
                                        data-category-id="@category.Id" data-category-name="@category.CategoryType" title="Edit">
                                    <i class="icon-pencil7 icon-2x"></i>
                                </button>
                            </li>
                            <li class="text-danger-600">
                                <button type="button" class="btn btn-link text-danger-600 delete-category-btn" data-toggle="modal" data-target="#categoryModal"
                                        data-category-id="@category.Id" data-category-name="@category.CategoryType" title="Delete">
                                    <i class="icon-trash icon-2x"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="panel-footer" style="margin-top:20px">
    @await Html.PartialAsync("_PaginationPartial", Model)
</div>
