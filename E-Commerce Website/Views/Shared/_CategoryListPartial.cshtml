@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<Category>

<div class="table-responsive border-top-lg border-top-primary">
    <table class="table table-striped table-hover">
        <thead>
            <tr class="bg-blue">
                <th>Category Name</th>
                <th class="text-center" style="width: 100px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">No categories found.</td>
                </tr>
            }
            @foreach (var category in Model.Items)
            {
                <tr>
                    <td>@category.CategoryType</td>
                    <td class="text-center">
                        <ul class="icons-list">
                            <li><a href="@Url.Action("EditCategory", "Admin", new { id = category.Id })" data-popup="tooltip" title="Edit"><i class="icon-pencil7"></i></a></li>
                            <li>
                                <form method="post" action="@Url.Action("RemoveCategory", "Admin")" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this category? This cannot be undone.')">
                                    <input type="hidden" name="categoryId" value="@category.Id" />
                                    <button type="submit" style="background:none; border:none; padding:0; cursor:pointer; color:#D84315;" data-popup="tooltip" title="Delete">
                                        <i class="icon-trash"></i>
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="panel panel-flat">
    <div class="panel-footer" style="margin-top:20px">
        @await Html.PartialAsync("_PaginationPartial", Model)
    </div>
</div>