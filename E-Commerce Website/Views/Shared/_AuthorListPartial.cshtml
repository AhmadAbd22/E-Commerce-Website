@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<Author>

<div class="table-responsive border-top-lg border-top-primary">
    <table class="table table-hover">
        <thead>
            <tr class="bg-blue">
                <th>Author Name</th>
                <th class="text-center text-size-large" style="width: 100px;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Items.Any())
            {
                <tr>
                    <td colspan="2" class="text-center text-muted">No authors found.</td>
                </tr>
            }
            @foreach (var author in Model.Items)
            {
                <tr class="text-size-large">
                    <td class="col-md-10">@author.AuthorName</td>
                    <td class="text-center col-md-2">
                        <ul class="icons-list">
                            <li class="text-primary-600">
                                <button type="button" class="btn btn-link edit-author-btn" data-toggle="modal" data-target="#authorModal"
                                        data-author-id="@author.Id"
                                        data-author-name="@author.AuthorName">
                                    <i class="icon-pencil7 icon-2x"></i>
                                </button>
                            </li>
                            <li class="text-danger-600">
                                    <input type="hidden" name="authorId" value="@author.Id" />
                                <button type="button" class="btn btn-link text-danger-600 delete-author-btn" data-toggle="modal" data-target="#authorModal"
                                        data-author-id="@author.Id"
                                        data-author-name="@author.AuthorName">
                                    <i class="icon-trash icon-2x"></i>
                                </button>
                            </li>
                        </ul>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

    <div class="panel-footer" style="margin-top:20px">
        @await Html.PartialAsync("_PaginationPartial", Model)
    </div>
