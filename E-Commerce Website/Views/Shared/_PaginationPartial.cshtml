@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<BookDto>

@if (Model.TotalPages > 1)
{
    <div class="pagination-wrapper text-center">
        <div class="pagination-info">
            <span class="text-muted text-center">
                Showing @Model.StartItem to @Model.EndItem of @Model.TotalCount entries
            </span>
        </div>

            <nav aria-label="Page navigation">
                <ul class="pagination pagination-rounded text-center">
                    <!-- Previous button -->
                    @if (Model.HasPreviousPage)
                    {
                        <li><a href="#" data-page="@(Model.CurrentPage - 1)" class="legitRipple" aria-label="Previous">Prev &nbsp; &larr;</a></li>
                    }
                    else
                    {
                        <li class="disabled"><a href="#">‹</a></li>
                    }

                    <!-- Page numbers -->
                    @{
                        int startPage = Math.Max(1, Model.CurrentPage - 2);
                        int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                    }

                    @if (startPage > 1)
                    {
                        <li><a href="#" data-page="1" class="legitRipple pagination-link">1</a></li>
                        @if (startPage > 2)
                        {
                            <li class="disabled"><span>...</span></li>
                        }
                    }

                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="@(i == Model.CurrentPage ? "active" : "")">
                            <a href="#" data-page="@i" class="@(i == Model.CurrentPage ? "" : "legitRipple") pagination-link">@i</a>
                        </li>
                    }

                    @if (endPage < Model.TotalPages)
                    {
                        @if (endPage < Model.TotalPages - 1)
                        {
                            <li class="disabled"><span>...</span></li>
                        }
                        <li><a href="#" data-page="@Model.TotalPages" class="legitRipple pagination-link">@Model.TotalPages</a></li>
                    }

                    <!-- Next button -->
                    @if (Model.HasNextPage)
                    {
                        <li><a href="#" data-page="@(Model.CurrentPage + 1)" class="legitRipple" aria-label="Next">Next &nbsp; &rarr;</a></li>
                    }
                    else
                    {
                        <li class="disabled"><a href="#">›</a></li>
                    }
                </ul>
            </nav>
        </div>
}

<style>
    .pagination-wrapper {
        margin-top: 20px;
        margin-bottom: 20px;
    }

    .pagination-info {
        padding-top: 8px;
    }

    .pagination-link.disabled {
        pointer-events: none;
        cursor: default;
        opacity: 0.6;
    }

    .pagination > li > a:hover:not(.disabled) {
        background-color: #f5f5f5;
    }

    .pagination > .active > a {
        background-color: #26a69a;
        border-color: #26a69a;
    }

    .pagination > li.disabled > a {
        pointer-events: none;
        cursor: default;
        opacity: 0.6;
    }
</style>
