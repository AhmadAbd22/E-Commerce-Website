@using ECommerceWebsite.Models.Helping_Classes
@model IPagedResult
@{
    int startPage = Math.Max(1, Model.CurrentPage - 2);
    int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
    if (Model.TotalPages < 1) { startPage = 1; endPage = 1; }

    int prevSeriesPage = Math.Max(1, Model.CurrentPage - 3);
    int nextSeriesPage = Math.Min(Model.TotalPages, Model.CurrentPage + 3);
}

<div class="pagination-container">

    <div class="page-size-controls">
        <div class="form-inline">
            <label class="ml-10">Show</label>
            <select id="page-size-selector" class="select-picker" style="display: inline-block; width:60%;">
                <option value="10" selected="@(Model.PageSize == 10)">10</option>
                <option value="15" selected="@(Model.PageSize == 15)">15</option>
                <option value="20" selected="@(Model.PageSize == 20)">20</option>
                <option value="25" selected="@(Model.PageSize == 25)">25</option>
                <option value="30" selected="@(Model.PageSize == 30)">30</option>
            </select>
            <span class="text-muted ml-10">
                Showing @Model.StartItem to @Model.EndItem of @Model.TotalCount entries
            </span>
        </div>
    </div>

    <!-- Right Side: The pagination buttons -->
    <ul class="pagination pagination-flat pagination-rounded" style="margin: 0;">
        <li><a href="#" data-page="@prevSeriesPage" class="@(Model.CurrentPage > 1 ? "" : "disabled") legitRipple">&laquo;</a></li>
        <li><a href="#" data-page="@(Model.CurrentPage - 1)" class="@(Model.HasPreviousPage ? "" : "disabled") legitRipple">&lsaquo;</a></li>
        @if (startPage > 1)
        {
            <li><a href="#" data-page="1" class="legitRipple">1</a></li>
            if (startPage > 2) { <li class="disabled"><a>...</a></li> }
        }
        @for (int i = startPage; i <= endPage; i++)
        {
            <li class="@(i == Model.CurrentPage ? "active" : "")"><a href="#" data-page="@i" class="legitRipple">@i</a></li>
        }
        @if (endPage < Model.TotalPages)
        {
            if (endPage < Model.TotalPages - 1) { <li class="disabled"><a>...</a></li> }
            <li><a href="#" data-page="@Model.TotalPages" class="legitRipple">@Model.TotalPages</a></li>
        }
        <li><a href="#" data-page="@(Model.CurrentPage + 1)" class="@(Model.HasNextPage ? "" : "disabled") legitRipple">&rsaquo;</a></li>
        <li><a href="#" data-page="@nextSeriesPage" class="@(Model.CurrentPage < Model.TotalPages ? "" : "disabled") legitRipple">&raquo;</a></li>
    </ul>
</div>

<style>
    .pagination-container {
        position: relative; 
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 38px; 
    }
    .page-size-controls {
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
    }
    .pagination li a.disabled {
        pointer-events: none;
        cursor: not-allowed;
        opacity: 0.6;
    }
    @@media (max-width: 991px) {
        .pagination-container { flex-direction: column; gap: 20px; }
        .page-size-controls { position: static; transform: none; margin: 0 auto; left: auto; top: auto; }
    }
</style>

@section Scripts {
        function initializePlugins(pagination-container) {
                    // activate all themed selects within the given container
                    container.find('.select-picker').selectpicker();
                    // tooltips (if any)
                    container.find('[data-popup="tooltip"]').tooltip();
                }
}