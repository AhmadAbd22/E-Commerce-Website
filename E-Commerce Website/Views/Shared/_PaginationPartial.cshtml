@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<BookDto>

@if (Model.TotalPages > 1)
{
    <div class="pagination-wrapper">
        <div class="row">
            <div class="col-sm-6">
                <div class="pagination-info">
                    <span class="text-muted">
                        Showing @Model.StartItem to @Model.EndItem of @Model.TotalCount entries
                    </span>
                </div>
            </div>
            <div class="col-sm-6">
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-flat pagination-sm pull-right">
                        <!-- Previous button -->
                        <li class="@(!Model.HasPreviousPage ? "disabled" : "")">
                            <a href="#" data-page="@(Model.CurrentPage - 1)" 
                               class="pagination-link @(!Model.HasPreviousPage ? "disabled" : "")"
                               aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        <!-- Page numbers -->
                        @{
                            int startPage = Math.Max(1, Model.CurrentPage - 2);
                            int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                        }

                        @if (startPage > 1)
                        {
                            <li><a href="#" data-page="1" class="pagination-link">1</a></li>
                            @if (startPage > 2)
                            {
                                <li class="disabled"><span>...</span></li>
                            }
                        }

                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="@(i == Model.CurrentPage ? "active" : "")">
                                <a href="#" data-page="@i" class="pagination-link">@i</a>
                            </li>
                        }

                        @if (endPage < Model.TotalPages)
                        {
                            @if (endPage < Model.TotalPages - 1)
                            {
                                <li class="disabled"><span>...</span></li>
                            }
                            <li><a href="#" data-page="@Model.TotalPages" class="pagination-link">@Model.TotalPages</a></li>
                        }

                        <!-- Next button -->
                        <li class="@(!Model.HasNextPage ? "disabled" : "")">
                            <a href="#" data-page="@(Model.CurrentPage + 1)" 
                               class="pagination-link @(!Model.HasNextPage ? "disabled" : "")"
                               aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        </div>
    </div>
}

<style>
    .pagination-wrapper {
        margin-top: 20px;
        margin-bottom: 20px;
    }
    
    .pagination-info {
        padding-top: 8px;
    }
    
    .pagination-link.disabled {
        pointer-events: none;
        cursor: default;
        opacity: 0.6;
    }
    
    .pagination > li > a:hover:not(.disabled) {
        background-color: #f5f5f5;
    }
    
    .pagination > .active > a {
        background-color: #26a69a;
        border-color: #26a69a;
    }
</style>
