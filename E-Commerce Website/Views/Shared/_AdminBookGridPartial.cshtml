@model ECommerceWebsite.Models.Helping_Classes.PagedResult<BookDto>

<!-- Grid of Books -->
<div class="row">
    @if (!Model.Items.Any())
    {
        <div class="col-xs-12">
            <div class="panel panel-flat">
                <div class="panel-body text-center">
                    <i class="icon-book icon-3x text-muted mb-20"></i>
                    <h4 class="text-muted">No Books Found</h4>
                    <p class="text-muted">Try adjusting your search or filter criteria.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        @foreach (var book in Model.Items)
        {
            @await Html.PartialAsync("_AdminBookCardPartial", book)
        }
    }
</div>

<!-- Pagination  -->
@if (Model.TotalPages > 0)
{
    <div class="panel-footer">
        <div class="row">
            <div class="col-sm-6 text-left-sm text-center-xs">
                <span class="text-muted">Showing @Model.StartItem to @Model.EndItem of @Model.TotalCount results</span>
            </div>
            <div class="col-sm-6 text-right-sm text-center-xs">
                @if (Model.TotalPages > 1)
                {
                    <ul class="pagination pagination-rounded">
                        <!-- 'Previous' Link -->
                        @if (Model.HasPreviousPage)
                        {
                            <li><a href="#" data-page="@(Model.CurrentPage - 1)">&larr; &nbsp; Prev</a></li>
                        }

                        <!-- Page Number Links -->
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="@(i == Model.CurrentPage ? "active" : "")">
                                <a href="#" data-page="@i">@i</a>
                            </li>
                        }

                        <!-- 'Next' Link -->
                        @if (Model.HasNextPage)
                        {
                            <li><a href="#" data-page="@(Model.CurrentPage + 1)">Next &nbsp; &rarr;</a></li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
}