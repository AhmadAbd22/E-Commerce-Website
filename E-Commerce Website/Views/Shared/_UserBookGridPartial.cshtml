@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<BookDto>

<!-- Renders the grid of book cards -->
<div class="row">
    @if (!Model.Items.Any())
    {
        <div class="col-xs-12">
            <div class="alert alert-info text-center">
                <i class="icon-info22 icon-2x"></i>
                <h5>No Books Found</h5>
                <p>Please try adjusting your search or filter criteria.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var book in Model.Items)
        {
            @await Html.PartialAsync("_BookCardPartial", book)
        }
    }
</div>

    <div class="panel-footer" >
    @await Html.PartialAsync("_PaginationPartial", Model)
    </div>
<!-- 🔹 Shared modal -->
@await Html.PartialAsync("_BookModalPartial")

@section Scripts {
    <script>
        // Handle View Product button click
        $(document).on("click", ".view-book-btn", function () {
            var bookId = $(this).data("id");
            $("#bookModal").modal("show");
            $("#bookModalBody").html('<div class="text-center"><i class="icon-spinner2 spinner"></i> Loading...</div>');

            $.get("/Book/GetBookDetails", { id: bookId }, function (data) {
                $("#bookModalBody").html(data);
            }).fail(function () {
                $("#bookModalBody").html('<div class="alert alert-danger">Failed to load book details.</div>');
            });
        });
    </script>
}
