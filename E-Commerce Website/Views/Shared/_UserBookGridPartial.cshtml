@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<BookDto>

<div class="row">
    @if (!Model.Items.Any())
    {
        <div class="col-xs-12">
            <div class="alert alert-info text-center">
                <i class="icon-info22 icon-2x"></i>
                <h5>No Books Found</h5>
                <p>Please try adjusting your search or filter criteria.</p>
            </div>
        </div>
    }
    else
    {
        @foreach (var book in Model.Items)
        {
            @await Html.PartialAsync("_BookCardPartial", book)
        }
    }
</div>

<div class="panel-footer">
    @await Html.PartialAsync("_PaginationPartial", Model)
</div>

<!-- Shared Modal -->
<div class="modal fade" id="userBookModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="margin:150px auto">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Book Details</h1>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="userBookModalBody">
                <div class="text-center">
                    <i class="icon-spinner2 spinner"></i> Loading...
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Shared Modal for User Books -->
<div class="modal fade" id="userBookModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="margin: 150px auto">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title">Book Details</h1>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="userBookModalBody">
                <div class="text-center">
                    <i class="icon-spinner2 spinner"></i> Loading...
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).on("click", ".view-book-btn", function () {
            var bookId = $(this).data("book-id"); 
            $("#userBookModal").modal("show");
            $("#userBookModalBody").html('<div class="text-center"><i class="icon-spinner2 spinner"></i> Loading...</div>');

            $.get("/UserHome/Details", { id: bookId }, function (data) {
                $("#userBookModalBody").html(data);
            }).fail(function () {
                $("#userBookModalBody").html('<div class="alert alert-danger">Failed to load book details.</div>');
            });
        });
    </script>
}
