@{
    var notifications = new List<(string Type, string Icon, string Message)>();

    if (TempData["Success"] != null)
    {
        notifications.Add(("success", "bi-check-circle-fill", TempData["Success"].ToString()));
    }
    if (TempData["Error"] != null)
    {
        notifications.Add(("danger", "bi-x-circle-fill", TempData["Error"].ToString()));
    }
    if (TempData["Info"] != null)
    {
        notifications.Add(("info", "bi-info-circle-fill", TempData["Info"].ToString()));
    }
    if (TempData["Warning"] != null)
    {
        notifications.Add(("warning", "bi-exclamation-triangle-fill", TempData["Warning"].ToString()));
    }
}

@if (notifications.Any())
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        @foreach (var n in notifications)
        {
            var toastId = "toast_" + Guid.NewGuid().ToString("N");
            <div id="@toastId" class="toast align-items-center text-bg-@n.Type border-0 mb-2"
                 role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body d-flex align-items-center">
                        <i class="bi @n.Icon me-2"></i>
                        <span>@n.Message</span>
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    var el = document.getElementById("@toastId");
                    var toast = new bootstrap.Toast(el, { delay: 5000 });
                    toast.show();
                });
            </script>
        }
    </div>
}
