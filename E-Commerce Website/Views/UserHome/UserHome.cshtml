@using ECommerceWebsite.Models.Helping_Classes
@model PagedResult<BookDto>

@{
    ViewData["Title"] = "Our Bookstore";
    Layout = "_UserLayout";

    string currentSearch = ViewData["Search"] as string ?? "";
    Guid? currentAuthorId = ViewData["AuthorId"] as Guid?;
    Guid? currentCategoryId = ViewData["CategoryId"] as Guid?;
    decimal? currentMinPrice = ViewData["MinPrice"] as decimal?;
    decimal? currentMaxPrice = ViewData["MaxPrice"] as decimal?;
    string currentSortBy = ViewData["SortBy"] as string ?? "";
    string currentSortOrder = ViewData["SortOrder"] as string ?? "";

    IEnumerable<Author> authors = ViewData["Authors"] as IEnumerable<Author> ?? new List<Author>();
    IEnumerable<Category> categories = ViewData["Categories"] as IEnumerable<Category> ?? new List<Category>();
}

<!-- Page Header -->
<div class="page-header page-header-default">
    <div class="page-header-content">
        <div class="page-title">
            <h4><i class="icon-store position-left"></i> <span class="text-semibold">Bookstore</span> - All Books</h4>
        </div>
    </div>
    <div class="breadcrumb-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("UserHome", "UserHome")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li class="active">Store</li>
        </ul>
    </div>
</div>

<!-- Content Area -->
<div class="content">

    <!-- Filter Panel -->
    <div class="panel panel-flat">
        <div class="panel-heading">
            <h6 class="panel-title">
                <i class="icon-filter4 position-left"></i> Search, Filter & Sort Options
            </h6>
        </div>
        <div class="panel-body">

            <!-- Sort Row -->
            <div class="row mb-15">
                <div class="col-md-4">
                    <label class="text-semibold">
                        <i class="icon-sort-amount-asc position-left"></i> Sort By
                    </label>
                    <select id="sort-dropdown" class="form-control select-picker">
                        @{
                            string currentSort = !string.IsNullOrEmpty(currentSortBy) ? $"{currentSortBy}|{currentSortOrder}" : "";
                        }
                        <option value="" selected="@(string.IsNullOrEmpty(currentSortBy))">Default (Newest First)</option>
                        <option value="title|asc" selected="@(currentSort == "title|asc")">Title (A-Z)</option>
                        <option value="title|desc" selected="@(currentSort == "title|desc")">Title (Z-A)</option>
                        <option value="author|asc" selected="@(currentSort == "author|asc")">Author (A-Z)</option>
                        <option value="author|desc" selected="@(currentSort == "author|desc")">Author (Z-A)</option>
                        <option value="category|asc" selected="@(currentSort == "category|asc")">Category (A-Z)</option>
                        <option value="category|desc" selected="@(currentSort == "category|desc")">Category (Z-A)</option>
                        <option value="price|asc" selected="@(currentSort == "price|asc")">Price (Low to High)</option>
                        <option value="price|desc" selected="@(currentSort == "price|desc")">Price (High to Low)</option>
                        <option value="date|desc" selected="@(currentSort == "date|desc")">Date (Newest First)</option>
                        <option value="date|asc" selected="@(currentSort == "date|asc")">Date (Oldest First)</option>
                    </select>
                </div>
                <div class="col-md-8 text-right">
                    <button type="button" id="clear-all-btn" class="btn btn-default">
                        <i class="icon-reset position-left"></i> Clear All Filters
                    </button>
                </div>
            </div>

            <hr class="content-divider">

            <!-- Filter Form -->
            <form id="user-filter-form" action="@Url.Action("UserHome", "UserHome")" method="get">
                <div class="row">
                    <div class="col-md-4">
                        <label class="text-semibold"><i class="icon-search4 position-left"></i> Search by Title/Author</label>
                        <input type="search" name="search" id="search-input" class="form-control" placeholder="Search books..." value="@currentSearch">
                    </div>

                    <div class="col-md-2">
                        <label class="text-semibold">Author</label>
                        <select name="authorId" id="author-filter" class="form-control select-picker" data-live-search="true">
                            <option value="">All Authors</option>
                            @foreach (var author in authors)
                            {
                                <option value="@author.Id" selected="@(author.Id == currentAuthorId)">@author.AuthorName</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="text-semibold">Category</label>
                        <select name="categoryId" id="category-filter" class="form-control select-picker" data-live-search="true">
                            <option value="">All Categories</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id" selected="@(category.Id == currentCategoryId)">@category.CategoryType</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="text-semibold">Price Range</label>
                        <div class="input-group">
                            <input type="number" name="minPrice" id="min-price-filter" placeholder="Min" class="form-control price-input" value="@currentMinPrice" min="0" step="0.01">
                            <span class="input-group-addon">-</span>
                            <input type="number" name="maxPrice" id="max-price-filter" placeholder="Max" class="form-control price-input" value="@currentMaxPrice" min="0" step="0.01">
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- AJAX Book List -->
    <div id="user-book-container">
        @await Html.PartialAsync("_UserBookGridPartial", Model)
    </div>
</div>

<!-- Book Modal -->
<div class="modal fade" id="userBookModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userBookModalTitle">Book Details</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body" id="userBookModalBody">
                <div class="text-center"><i class="icon-spinner2 spinner icon-2x"></i> Loading...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                <button type="button" class="btn btn-success" id="addToCartBtn"><i class="icon-cart-plus position-left"></i> Add to Cart</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(function() {
            // Initialize selectpickers
            $('.select-picker').selectpicker();

            var debounceTimeout;

            function getCurrentSortValues() {
                var sortValue = $('#sort-dropdown').val();
                if (!sortValue) return { sortBy: '', sortOrder: '' };
                var parts = sortValue.split('|');
                return { sortBy: parts[0] || '', sortOrder: parts[1] || '' };
            }

            function validatePriceInput(input) {
                var value = parseFloat(input.val());
                if (value < 0 || isNaN(value)) { input.val(''); return false; }
                return true;
            }

            function fetchUserPage(pageNumber) {
                var search = $('#search-input').val();
                var authorId = $('#author-filter').val();
                var categoryId = $('#category-filter').val();
                var minPrice = $('#min-price-filter').val();
                var maxPrice = $('#max-price-filter').val();
                var sortValues = getCurrentSortValues();

                var url = '@Url.Action("UserHome", "UserHome")' +
                    '?pageNumber=' + pageNumber +
                    '&search=' + encodeURIComponent(search) +
                    '&authorId=' + encodeURIComponent(authorId) +
                    '&categoryId=' + encodeURIComponent(categoryId) +
                    '&minPrice=' + encodeURIComponent(minPrice) +
                    '&maxPrice=' + encodeURIComponent(maxPrice) +
                    '&sortBy=' + encodeURIComponent(sortValues.sortBy) +
                    '&sortOrder=' + encodeURIComponent(sortValues.sortOrder);

                $('#user-book-container').html('<div class="text-center p-20"><h4><i class="icon-spinner2 spinner"></i> Loading Books...</h4></div>');

                $.get(url, function(data) {
                    $('#user-book-container').html(data);
                    $('.select-picker').selectpicker();
                }).fail(function() {
                    $('#user-book-container').html('<div class="alert alert-danger">Failed to load books.</div>');
                });
            }

            // Event Handlers
            $('#sort-dropdown').on('change', function() { fetchUserPage(1); });
            $('#clear-all-btn').on('click', function() {
                $('#user-filter-form')[0].reset();
                $('.select-picker').selectpicker('refresh');
                fetchUserPage(1);
            });
            $('#author-filter, #category-filter').on('change', function() { fetchUserPage(1); });
            $('#search-input, #min-price-filter, #max-price-filter').on('input', function() {
                validatePriceInput($(this));
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(function() { fetchUserPage(1); }, 300);
            });
            $('#user-book-container').on('click', '.pagination a', function(e) {
                e.preventDefault();
                var page = $(this).data('page');
                if(page) fetchUserPage(page);
            });
            $('#user-filter-form').on('submit', function(e) { e.preventDefault(); fetchUserPage(1); });

            // View Book Modal & Add to Cart
            $(document).on('click', '.view-book-btn', function() {
                var bookId = $(this).data('book-id');

                $("#userBookModal").modal('show');
                $("#userBookModalTitle").text('Loading Details...');
                $("#userBookModalBody").html('<div class="text-center"><i class="icon-spinner2 spinner icon-2x"></i></div>');

                $.get('/UserHome/Details', { id: bookId }, function(data) {
                    $("#userBookModalBody").html(data);
                    var title = $(data).find('h3').first().text();
                    $("#userBookModalTitle").text(title || 'Book Details');

                    // Add to Cart button
                    $("#addToCartBtn").show().off('click').on('click', function() {
                        $.post('/Cart/Add', { bookId: bookId, quantity: 1 }, function(res) {
                            if(res.success) { alert('Book added to cart!'); $("#userBookModal").modal('hide'); }
                            else { alert('Failed to add book to cart.'); }
                        });
                    });
                }).fail(function() {
                    $("#userBookModalTitle").text('Error');
                    $("#userBookModalBody").html('<div class="alert alert-danger">Failed to load book details.</div>');
                });
            });
        });
    </script>
}
