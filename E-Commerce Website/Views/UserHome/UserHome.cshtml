@model IEnumerable<BookDto>
@{
    ViewData["Title"] = "Our Bookstore";
    Layout = "_UserLayout";
}

<!-- Page header -->
<div class="page-header page-header-default">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible">
            <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
            @TempData["Error"]
        </div>
    }

    <div class="page-header-content">
        <div class="page-title">
            <h4><i class="icon-store position-left"></i> <span class="text-semibold">Bookstore</span> - All Books</h4>
        </div>
    </div>
    <div class="
-line">
        <ul class="breadcrumb">
            <li><a href="@Url.Action("UserHome", "UserHome")"><i class="icon-home2 position-left"></i> Home</a></li>
            <li class="active">Store</li>
        </ul>
        <!-- Filter Toggle Button for Mobile -->
        <div class="breadcrumb-elements">
            <button type="button" class="btn btn-link filter-toggle visible-xs" id="filter-toggle">
                <i class="icon-menu-open position-left"></i> Filters
            </button>
        </div>
    </div>
</div>
<!-- /page header -->
<!-- Content area -->
<div class="content">
    <div class="row">
        <!-- Main content area -->
        <div class="col-lg-9 col-md-8" id="main-content">
            <!-- Search bar -->
            <div class="panel panel-flat">
                <div class="panel-body">
                    <div class="form-group has-feedback has-feedback-left">
                        <input type="search" id="book-search" class="form-control" placeholder="Search books by title, author, or description...">
                        <div class="form-control-feedback">
                            <i class="icon-search4 text-size-small text-muted"></i>
                        </div>
                    </div>
                    <div class="row mt-10">
                        <div class="col-sm-4">
                            <select id="author-filter" class="form-control">
                                <option value="">All Authors</option>
                                @if (ViewData["Authors"] is IEnumerable<Author> authors)
                                {
                                    foreach (var author in authors)
                                    {
                                        <option value="@author.AuthorName">@author.AuthorName</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <select id="category-filter" class="form-control">
                                <option value="">All Categories</option>
                                @if (ViewData["Categories"] is IEnumerable<Category> categories)
                                {
                                    foreach (var category in categories)
                                    {
                                        <option value="@category.CategoryType">@category.CategoryType</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-sm-4">
                            <button type="button" id="clear-filters" class="btn btn-default btn-block">
                                <i class="icon-reset position-left"></i> Clear Filters
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- No Results Message -->
            <div id="no-results" class="alert alert-info text-center" style="display: none;">
                <i class="icon-info22 icon-2x"></i>
                <h5>No books found</h5>
                <p>Try adjusting your search criteria or clear the filters to see all books.</p>
            </div>

            <!-- Grid of Books -->
            <div class="row book-grid">
                @if (!Model.Any())
                {
                    <div class="col-xs-12">
                        <div class="alert alert-info text-center">No books found matching your criteria.</div>
                    </div>
                }
                else
                {
                    @foreach (var book in Model)
                    {
                        @await Html.PartialAsync("_BookCardPartial", book)
                    }
                }
            </div>
        </div>

        <!-- Right Filter Sidebar -->
        <div class="col-lg-3 col-md-4" id="filter-sidebar">
            <div class="sidebar-fixed">
                <div class="panel panel-flat">
                    <div class="panel-heading">
                        <h6 class="panel-title">
                            <i class="icon-filter3 position-left"></i>
                            Filter Products
                            <button type="button" class="btn btn-link btn-xs pull-right filter-close visible-xs" id="filter-close">
                                <i class="icon-cross2"></i>
                            </button>
                        </h6>
                    </div>
                    <div class="panel-body">
                        <form action="@Url.Action("UserHome", "UserHome")" method="post">
                            <div class="form-group">
                                <label class="text-semibold">By Category</label>
                                <select name="categoryId" class="form-control">
                                    <option value="">All Categories</option>
                                    @if (ViewData["Categories"] is IEnumerable<Category> categories)
                                    {
                                        foreach (var category in categories)
                                        {
                                            <option value="@category.Id">@category.CategoryType</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="text-semibold">By Author</label>
                                <select name="authorId" class="form-control">
                                    <option value="">All Authors</option>
                                    @if (ViewData["Authors"] is IEnumerable<Author> authors)
                                    {
                                        foreach (var author in authors)
                                        {
                                            <option value="@author.Id">@author.AuthorName</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="form-group">
                                <label class="text-semibold">By Price Range</label>
                                <div class="row">
                                    <div class="col-xs-6">
                                        <input type="number" name="minPrice" placeholder="Min" class="form-control" step="0.01">
                                    </div>
                                    <div class="col-xs-6">
                                        <input type="number" name="maxPrice" placeholder="Max" class="form-control" step="0.01">
                                    </div>
                                </div>
                            </div>

                            <div class="form-group">
                                <button type="submit" class="btn bg-blue btn-block">
                                    <i class="icon-filter3 position-left"></i> Apply Filters
                                </button>
                                <button type="button" id="clear-sidebar-filters" class="btn btn-default btn-block mt-10">
                                    <i class="icon-reset position-left"></i> Clear All
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- /content area -->
@section Styles {
    <style>
        /* Filter Sidebar Styles */
        #filter-sidebar {
            transition: all 0.3s ease;
        }

        .sidebar-fixed {
            position: sticky;
            top: 20px;
            z-index: 100;
        }

        .filter-toggle, .filter-close {
            color: #fff;
            border: none;
            background: transparent;
            padding: 8px 15px;
        }

            .filter-toggle:hover, .filter-close:hover {
                background-color: rgba(255, 255, 255, 0.1);
                color: #fff;
            }

        .filter-close {
            color: #666;
            padding: 2px 8px;
        }

            .filter-close:hover {
                background-color: #f5f5f5;
                color: #333;
            }

        .breadcrumb-elements {
            float: right;
            margin-top: -5px;
        }

        .product-card {
            display: flex;
            flex-direction: column;
            height: 100%;
        }

            .product-card .panel-body-accent {
                margin-top: auto;
            }
    </style>
}

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function() {
            // Filter sidebar toggle functionality for mobile
            $('#filter-toggle').on('click', function() {
                $('#filter-sidebar').addClass('active');
                $('body').append('<div class="sidebar-backdrop"></div>');
                $('.sidebar-backdrop').addClass('active');
                $('#main-content').addClass('sidebar-open');
            });

            // Close filter sidebar
            $('#filter-close, .sidebar-backdrop').on('click', function() {
                $('#filter-sidebar').removeClass('active');
                $('.sidebar-backdrop').removeClass('active');
                $('#main-content').removeClass('sidebar-open');
                setTimeout(function() {
                    $('.sidebar-backdrop').remove();
                }, 300);
            });

            // Close sidebar on escape key
            $(document).on('keyup', function(e) {
                if (e.keyCode === 27) { // Escape key
                    $('#filter-close').click();
                }
            });

            // Clear Filters button functionality
            $('#clear-filters').on('click', function() {
                // Clear search input
                $('#book-search').val('');

                // Reset filter dropdowns
                $('#author-filter').val('');
                $('#category-filter').val('');

                // Show all book cards (only target book card containers)
                $('.book-grid > div').show();

                // Hide no results message
                $('#no-results').hide();
            });

            // Clear sidebar filters
            $('#clear-sidebar-filters').on('click', function() {
                // Clear sidebar form filters
                $('select[name="categoryId"]').val('');
                $('select[name="authorId"]').val('');
                $('input[name="minPrice"]').val('');
                $('input[name="maxPrice"]').val('');

                // Also trigger the main clear functionality
                $('#clear-filters').click();
            });

            // Search functionality for real-time filtering
            $('#book-search, #author-filter, #category-filter').on('input change', function() {
                filterBooks();
            });

            function filterBooks() {
                var searchTerm = $('#book-search').val().toLowerCase();
                var selectedAuthor = $('#author-filter').val().toLowerCase();
                var selectedCategory = $('#category-filter').val().toLowerCase();
                var visibleCount = 0;

                // Target only book card containers
                $('.book-grid > div').each(function() {
                    var bookCard = $(this);
                    var bookText = bookCard.text().toLowerCase();
                    var bookAuthor = bookCard.find('p.text-muted').first().text().toLowerCase().replace('by ', '') || '';

                    var matchesSearch = searchTerm === '' || bookText.indexOf(searchTerm) > -1;
                    var matchesAuthor = selectedAuthor === '' || bookAuthor.indexOf(selectedAuthor) > -1;
                    var matchesCategory = selectedCategory === '' || bookText.indexOf(selectedCategory) > -1;

                    if (matchesSearch && matchesAuthor && matchesCategory) {
                        bookCard.show();
                        visibleCount++;
                    } else {
                        bookCard.hide();
                    }
                });

                if (visibleCount === 0) {
                    $('#no-results').show();
                } else {
                    $('#no-results').hide();
                }
            }
        });
    </script>
}

